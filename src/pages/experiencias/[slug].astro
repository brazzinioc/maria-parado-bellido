---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PhotoCard from "../../components/PhotoCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PriceNote from "../../components/PriceNote.astro";
import AporteNote from "../../components/AporteNote.astro";
import ExperienceTourCard from "../../components/ExperienceTourCard.astro";
import { getExperiences, type Experience } from "../../lib/content";
import { fetchPlaces, fetchTours, fetchSiteSettings } from "../../lib/api";
import { placeCategoryLabel, placeCoverImage } from "../../lib/places";
import { whatsappUrl } from "../../lib/whatsapp";

export async function getStaticPaths() {
  const experiences = await getExperiences();
  return experiences.map((experience) => ({
    params: { slug: experience.slug },
    props: { experience, others: experiences.filter((e) => e.slug !== experience.slug) },
  }));
}

interface Props {
  experience: Experience;
  others: Experience[];
}

const { experience, others } = Astro.props;

// Rutas: tours del CMS asociados a esta experiencia (t_tours.experience).
// Los tours de respaldo no tienen experiencia, así que nunca se muestran aquí.
// Ordenadas de fácil a exigente y, en cada nivel, de la más corta a la más larga.
const DIFFICULTY_ORDER = { easy: 0, moderate: 1, hard: 2 } as const;
const DIFFICULTY_FILTERS = [
  { key: "easy", label: "Fácil" },
  { key: "moderate", label: "Moderada" },
  { key: "hard", label: "Exigente" },
] as const;
const { showPrices } = await fetchSiteSettings();
const tours = (await fetchTours())
  .filter((t) => t.experience === experience.slug)
  .sort(
    (a, b) =>
      (a.difficulty ? DIFFICULTY_ORDER[a.difficulty] : 3) - (b.difficulty ? DIFFICULTY_ORDER[b.difficulty] : 3) ||
      a.duration_hours - b.duration_hours ||
      a.title.localeCompare(b.title, "es"),
  );
// Filtros por dificultad solo cuando hay muchas rutas y más de un nivel.
const difficultyFilters = DIFFICULTY_FILTERS.map((f) => ({
  ...f,
  count: tours.filter((t) => t.difficulty === f.key).length,
})).filter((f) => f.count > 0);
const showFilters = tours.length >= 5 && difficultyFilters.length > 1;

// Galería: fotos propias de las rutas. Solo se muestra si hay suficientes.
const gallery = [...new Set(tours.flatMap((t) => t.images))].slice(0, 5);

// Lugares: primero los elegidos para la experiencia (experience.places), luego
// se completa con el resto: antes los que tienen foto y, entre ellos, los de la
// categoría afín (naturales para trekking/cicloturismo, culturales para vivencial).
const places = await fetchPlaces();
const curated = (experience.places ?? [])
  .map((slug) => places.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const preferred =
  experience.slug === "turismo-vivencial"
    ? ["cultural", "historical", "archaeological"]
    : ["natural", "archaeological"];
const rank = (p: (typeof places)[number]) =>
  (p.images.length > 0 ? 0 : 2) + (preferred.includes(p.category) ? 0 : 1);
const suggestedPlaces = [
  ...curated,
  ...places.filter((p) => !curated.includes(p)).sort((a, b) => rank(a) - rank(b)),
].slice(0, 3);
// Con 1 o 2 lugares, tarjetas horizontales: una sola tarjeta vertical se ve suelta.
const placeLayout =
  suggestedPlaces.length >= 3
    ? { grid: "grid-cols-1 md:grid-cols-3", size: "tall" as const }
    : suggestedPlaces.length === 2
      ? { grid: "grid-cols-1 md:grid-cols-2", size: "wide" as const }
      : { grid: "grid-cols-1 max-w-2xl", size: "wide" as const };

const activity = experience.title.toLowerCase();
const contactMessage = `Hola, quiero hacer ${activity} en María Parado de Bellido. ¿Me pueden ayudar a organizarlo?`;
const contactUrl = whatsappUrl(contactMessage);

const faqs = experience.faqs ?? [];
const calendar = experience.calendar ?? [];
const packing = experience.packing;
const safety = experience.safety ?? [];

const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Experiencias", url: "/experiencias/" },
  { name: experience.title, url: `/experiencias/${experience.slug}/` },
];

const structuredData = [
  {
    type: "experience" as const,
    data: {
      ...experience,
      places: suggestedPlaces.map((p) => ({ name: p.name, slug: p.slug })),
    },
  },
  ...(faqs.length > 0 ? [{ type: "faq" as const, data: { faqs } }] : []),
];
---

<BaseLayout
  title={experience.seo.title}
  description={experience.seo.description}
  image={experience.image}
  keywords={experience.seo.keywords}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
  whatsappMessage={contactMessage}
>
  <PageHero
    eyebrow={experience.eyebrow}
    title={experience.title}
    intro={experience.tagline}
    image={experience.image}
    imageAlt={experience.imageAlt}
    imagePosition={experience.imagePosition}
    breadcrumbs={breadcrumbs}
    size="lg"
    transitionName={`foto-exp-${experience.slug}`}
  >
    <a slot="actions" href="#rutas" class="btn-primary">
      {tours.length === 0 ? "Cómo organizarlo" : showPrices ? "Ver rutas y precios" : "Ver rutas"}
    </a>
    <a slot="actions" href={contactUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost-light">
      Consultar por WhatsApp
    </a>
  </PageHero>

  <!-- Datos rápidos: 2×2 en móvil, una fila en escritorio -->
  <section class="bg-white border-b border-line">
    <dl class="container-custom grid grid-cols-2 md:grid-cols-4">
      {experience.stats.map((stat, i) => (
        <div
          class:list={[
            "py-5 md:py-6 border-line",
            i % 2 === 0 ? "pr-4 border-r" : "pl-4",
            i < 2 && "border-b md:border-b-0",
            "md:px-6 md:border-r md:first:pl-0 md:last:border-r-0",
          ]}
        >
          <dt class="text-xs font-semibold uppercase tracking-[0.15em] text-ink-soft">{stat.label}</dt>
          <dd class="mt-1 font-heading text-lg md:text-xl font-semibold text-ink">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Descripción + lo que vivirás + nivel -->
  <section class="py-20 md:py-24">
    <div class="container-custom grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-7">
        <span class="eyebrow">La experiencia</span>
        <h2 class="font-heading text-3xl md:text-4xl font-semibold leading-tight mb-6">{experience.headline ?? experience.summary}</h2>
        {experience.description.map((paragraph) => (
          <p class="text-lg leading-relaxed mb-5">{paragraph}</p>
        ))}
        {experience.secondaryImage && (
          <figure class="mt-8">
            <img
              src={experience.secondaryImage.src}
              alt={experience.secondaryImage.alt}
              loading="lazy"
              class="aspect-[16/10] w-full rounded-2xl object-cover"
              style={`object-position: ${experience.secondaryImage.position ?? "center"}`}
            />
            {experience.secondaryImage.caption && (
              <figcaption class="mt-2 text-sm text-ink-soft">{experience.secondaryImage.caption}</figcaption>
            )}
          </figure>
        )}
      </div>
      <aside class="lg:col-span-5 space-y-6">
        <div class="rounded-2xl bg-white border border-line p-6 md:p-8">
          <h3 class="font-heading text-2xl font-semibold mb-5">Lo que vivirás</h3>
          <ul class="space-y-3">
            {experience.highlights.map((item) => (
              <li class="flex gap-3">
                <svg class="mt-1 h-5 w-5 flex-shrink-0 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        {experience.level && (
          <div class="rounded-2xl bg-secondary-soft p-6 md:p-8">
            <h3 class="font-heading text-2xl font-semibold mb-3">Nivel requerido</h3>
            <p class="leading-relaxed">{experience.level}</p>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- Rutas y programas (tours del CMS) -->
  <section id="rutas" class="py-20 md:py-24 bg-white scroll-mt-20">
    <div class="container-custom">
      {tours.length > 0 ? (
        <>
          <SectionHeading
            eyebrow={showPrices ? "Rutas y precios" : "Rutas"}
            title={tours.length === 1 ? "Una ruta para empezar" : "Elige tu ruta"}
            intro="Salidas con guías del distrito. Escríbenos para confirmar fechas y disponibilidad."
            align="left"
          />
          {showFilters && (
            <div class="-mt-4 mb-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar rutas por dificultad" data-route-filters>
              <button type="button" class="route-filter" data-filter="all" aria-pressed="true">
                Todas <span class="opacity-70">{tours.length}</span>
              </button>
              {difficultyFilters.map((f) => (
                <button type="button" class="route-filter" data-filter={f.key} aria-pressed="false">
                  {f.label} <span class="opacity-70">{f.count}</span>
                </button>
              ))}
            </div>
          )}
          {!showPrices && (
            <AporteNote class="-mt-2 mb-8 max-w-3xl" para={experience.slug === "turismo-vivencial" ? "vivencial" : "ruta"} />
          )}
          {showPrices && tours.some((t) => t.price > 0) && (
            <PriceNote class="-mt-2 mb-8 max-w-3xl" text="* Precios referenciales por persona. Pueden variar según la temporada, el tamaño del grupo, la disponibilidad de guías y otras condiciones. Confirma el precio final por WhatsApp antes de reservar." />
          )}
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 md:gap-6" data-route-list>
            {tours.map((tour, i) => (
              <div class="grid" data-difficulty={tour.difficulty ?? "none"}>
                <ExperienceTourCard tour={tour} showPrices={showPrices} fallbackImage={`/images/placeholders/ruta-${experience.slug}-${(i % 3) + 1}.svg`} />
              </div>
            ))}
          </div>
        </>
      ) : (
        <div class="rounded-3xl border border-line bg-sand p-8 md:p-12 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2">
            <span class="eyebrow">Rutas a medida</span>
            <h2 class="font-heading text-3xl md:text-4xl font-semibold leading-tight mb-3">Armamos tu {activity} contigo</h2>
            <p class="text-lg leading-relaxed">
              Todavía no publicamos rutas para esta experiencia. Cuéntanos tus fechas y tu nivel, y te
              conectamos con un guía o una familia del distrito.
            </p>
            {!showPrices && <AporteNote class="mt-5" para={experience.slug === "turismo-vivencial" ? "vivencial" : "ruta"} />}
          </div>
          <div class="flex md:justify-end">
            <a href={contactUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Escribir por WhatsApp</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Calendario: labores de la chacra y fiestas por temporada -->
  {calendar.length > 0 && (
    <section class="py-20 md:py-24">
      <div class="container-custom">
        <SectionHeading
          eyebrow="Calendario"
          title="Qué vivir en cada temporada"
          intro="La vida en el distrito sigue el ritmo de la chacra y de las fiestas. Elige tu fecha según lo que quieras vivir."
          align="left"
        />
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {calendar.map((period) => (
            <li class="flex flex-col rounded-2xl border border-line bg-white p-6">
              <p class="font-heading text-xl font-semibold text-ink">{period.months}</p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-[0.15em] text-secondary">En la chacra</p>
              <p class="mt-1.5 text-sm leading-relaxed">{period.farm}</p>
              {period.festivities.length > 0 && (
                <>
                  <p class="mt-5 text-xs font-semibold uppercase tracking-[0.15em] text-primary">Fiestas y tradiciones</p>
                  <ul class="mt-1.5 space-y-1.5 text-sm">
                    {period.festivities.map((fest) => (
                      <li class="flex gap-2">
                        <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                        <span>{fest}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- Galería de las rutas -->
  {gallery.length >= 3 && (
    <section class="py-20 md:py-24">
      <div class="container-custom">
        <SectionHeading eyebrow="Galería" title="Así se vive" align="left" />
        <div class="grid grid-cols-2 md:grid-cols-4 md:grid-rows-2 gap-3 md:gap-4">
          {gallery.map((src, i) => (
            <div class:list={["overflow-hidden rounded-2xl bg-sand-200", i === 0 ? "col-span-2 md:row-span-2 aspect-[4/3] md:aspect-auto" : "aspect-square"]}>
              <img src={src} alt={`${experience.title} en María Parado de Bellido`} loading="lazy" class="h-full w-full object-cover" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Prepárate: qué llevar + seguridad -->
  {(packing || safety.length > 0) && (
    <section class="py-20 md:py-24">
      <div class="container-custom">
        <SectionHeading eyebrow="Prepárate" title="Antes de ir" align="left" />
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {packing && (
            <div class="rounded-2xl bg-white border border-line p-6 md:p-8">
              <h3 class="font-heading text-2xl font-semibold mb-5">Qué llevar</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-primary mb-3">Imprescindible</p>
                  <ul class="space-y-2.5">
                    {packing.required.map((item) => (
                      <li class="flex gap-3">
                        <svg class="mt-1 h-5 w-5 flex-shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-ink-soft mb-3">Recomendado</p>
                  <ul class="space-y-2.5">
                    {packing.recommended.map((item) => (
                      <li class="flex gap-3">
                        <span class="mt-2.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink-soft" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )}
          {safety.length > 0 && (
            <div class="rounded-2xl bg-accent-soft p-6 md:p-8">
              <h3 class="font-heading text-2xl font-semibold mb-5">Seguridad y respeto</h3>
              <ul class="space-y-3 list-disc pl-5 marker:text-primary">
                {safety.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Lugares donde se vive -->
  {suggestedPlaces.length > 0 && (
    <section class="py-20 md:py-24 bg-white">
      <div class="container-custom">
        <SectionHeading eyebrow="Dónde vivirlo" title="Destinos recomendados" align="left">
          <a slot="actions" href="/lugares/" class="btn-secondary">Ver todos los destinos</a>
        </SectionHeading>
        <div class:list={["grid gap-5 md:gap-6", placeLayout.grid]}>
          {suggestedPlaces.map((place) => (
            <PhotoCard
              href={`/lugares/${place.slug}/`}
              image={placeCoverImage(place)}
              alt={place.name}
              title={place.name}
              subtitle={placeCategoryLabel(place.category)}
              meta={place.location.name || "Pomabamba"}
              size={placeLayout.size}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Preguntas frecuentes -->
  {faqs.length > 0 && (
    <section class="py-20 md:py-24">
      <div class="container-custom max-w-3xl">
        <SectionHeading eyebrow="Preguntas frecuentes" title={`Sobre ${activity}`} />
        <div class="divide-y divide-line border-y border-line">
          {faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink text-lg">
                {faq.question}
                <svg class="h-5 w-5 flex-shrink-0 text-primary transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14" /></svg>
              </summary>
              <p class="mt-3 leading-relaxed">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="pb-20 md:pb-24">
    <div class="container-custom">
      <div class="rounded-3xl bg-secondary text-white p-8 md:p-14 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2">
          <h2 class="font-heading text-3xl md:text-4xl font-semibold !text-white mb-3">¿Te animas a vivirlo?</h2>
          <p class="text-white/85 text-lg">Te ayudamos con el transporte, el alojamiento y los guías locales.</p>
        </div>
        <div class="flex flex-col sm:flex-row md:flex-col gap-3 md:items-end">
          <a href={contactUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Escribir por WhatsApp</a>
          <a href="/planifica-tu-visita/" class="btn-ghost-light">Planifica tu visita</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Otras experiencias -->
  <section class="pb-20 md:pb-28">
    <div class="container-custom">
      <SectionHeading eyebrow="Sigue explorando" title="Otras experiencias" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        {others.map((exp) => (
          <PhotoCard
            href={`/experiencias/${exp.slug}/`}
            image={exp.image}
            alt={exp.imageAlt}
            title={exp.title}
            subtitle={exp.tagline}
            size="wide"
            cta="Descubrir"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .route-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: #fff;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }
  .route-filter:hover {
    border-color: color-mix(in srgb, var(--color-ink) 40%, transparent);
  }
  .route-filter[aria-pressed="true"] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }
</style>

<script>
  // Filtro de rutas por dificultad (el sitio usa ClientRouter: se reinicia en cada navegación).
  function initRouteFilters() {
    const group = document.querySelector<HTMLElement>("[data-route-filters]");
    const items = document.querySelectorAll<HTMLElement>("[data-route-list] > [data-difficulty]");
    if (!group) return;
    group.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
      if (!button) return;
      const filter = button.dataset.filter;
      group.querySelectorAll("[data-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      items.forEach((item) => {
        item.hidden = filter !== "all" && item.dataset.difficulty !== filter;
      });
    });
  }
  document.addEventListener("astro:page-load", initRouteFilters);
</script>
