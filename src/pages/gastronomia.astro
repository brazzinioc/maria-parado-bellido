---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { fetchDishes } from "../lib/api";
import { dishCoverImage } from "../lib/placeholders";

// Todos los platos salen del CMS (seed 08_platos.sql); sin datos de ejemplo.
const dishes = await fetchDishes();

const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Gastronomía", url: "/gastronomia" },
];

const zones = [
  { name: "Zona Quechua", products: ["Maíz", "Papa", "Trigo", "Cebada", "Habas", "Tuna", "Durazno"], text: "Valles templados donde crecen el maíz y los frutales." },
  { name: "Zona Suni", products: ["Quinua", "Kiwicha", "Papa nativa", "Oca", "Olluco", "Trucha"], text: "Laderas altas de granos andinos y tubérculos." },
  { name: "Zona Puna", products: ["Leche y queso", "Carne de ovino", "Lana"], text: "Pastos naturales para ovinos, vacunos y camélidos." },
];

const where = [
  { title: "En la feria de los viernes", text: "Queso fresco, papa, maíz y lo mejor de la chacra, directo de las familias.", href: "/comunidad", cta: "Ver la agenda" },
  { title: "En las fiestas", text: "Los cargontes comparten mondongo, puca picante y chicha de jora con toda la comunidad.", href: "/festividades", cta: "Ver el calendario de fiestas" },
  { title: "En casa de una familia", text: "Cocina en fogón de leña y comparte la mesa en una experiencia de turismo vivencial.", href: "/experiencias/turismo-vivencial", cta: "Turismo vivencial" },
];

const dishesStructuredData = [
  {
    type: "itemList" as const,
    data: {
      name: "Platos tradicionales de Pomabamba, María Parado de Bellido",
      description: "Gastronomía andina de Pomabamba, Cangallo (Ayacucho).",
      items: dishes.map((d) => ({ name: d.name, description: d.description, url: "/gastronomia", image: d.image })),
    },
  },
];
---

<BaseLayout
  title="Gastronomía de Pomabamba, Ayacucho: platos típicos y productos de la chacra"
  description="Platos típicos y productos de Pomabamba, María Parado de Bellido (Cangallo, Ayacucho): puca picante, mondongo, qapchi, pachamanca, queso fresco y chicha de jora."
  image="/images/gastronomia-andina-queso-habas-maiz-papa-nativa-pomabamba.webp"
  keywords={["gastronomía Pomabamba", "comida típica Ayacucho", "puca picante", "qapchi de habas", "queso fresco Ayacucho", "platos andinos Cangallo"]}
  breadcrumbs={breadcrumbs}
  structuredData={dishesStructuredData}
>
  <PageHero
    eyebrow="Gastronomía"
    title="Sabores de nuestra tierra"
    intro="Recetas de fogón de leña con lo que dan nuestros tres pisos ecológicos: del maíz de los valles al queso de las alturas."
    image="/images/gastronomia-andina-queso-habas-maiz-papa-nativa-pomabamba.webp"
    imageAlt="Queso fresco, habas, maíz y papa nativa, productos de la gastronomía de Pomabamba, Ayacucho"
    breadcrumbs={breadcrumbs}
  />

  <!-- Platos -->
  <section class="py-20 md:py-24">
    <div class="container-custom">
      <div class="max-w-3xl mb-14">
        <span class="eyebrow">Platos típicos</span>
        <h2 class="section-heading">Lo que tienes que probar</h2>
        <p class="text-lg leading-relaxed">
          Una cocina que nace de la chacra y se comparte: en la mesa familiar, en las faenas y, sobre todo, en las
          <strong class="text-ink">fiestas patronales</strong>.
        </p>
      </div>
      {dishes.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {dishes.map((dish) => (
            <article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-white">
              <div class="relative aspect-[16/10] overflow-hidden bg-sand-200">
                <img
                  src={dishCoverImage(dish)}
                  alt={`${dish.name}, plato típico de Pomabamba, María Parado de Bellido, Ayacucho`}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover object-[center_65%]"
                />
              </div>
              <div class="flex flex-1 flex-col p-5 md:p-6">
                <h3 class="font-heading text-2xl font-semibold leading-snug text-ink">{dish.name}</h3>
                <p class="mt-2 leading-relaxed">{dish.description}</p>
                {dish.ingredients.length > 0 && (
                  <ul class="mt-auto flex flex-wrap gap-1.5 pt-4" aria-label="Ingredientes principales">
                    {dish.ingredients.map((ingredient) => (
                      <li class="rounded-full bg-accent-soft px-2.5 py-1 text-xs font-semibold text-ink">{ingredient}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-line bg-white p-8 md:p-10 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
          <img src="/images/placeholders/plato-general.svg" alt="" aria-hidden="true" class="md:col-span-3 w-full max-w-[220px] rounded-xl" />
          <p class="md:col-span-9 text-lg leading-relaxed">Estamos preparando la carta de nuestros platos típicos. Mientras tanto, pruébalos en la feria de los viernes o en nuestras fiestas.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Dónde probar -->
  <section class="py-20 md:py-24 bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mb-10">
        <span class="eyebrow">Dónde probar</span>
        <h2 class="section-heading">La mejor mesa es la compartida</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {where.map((w, i) => (
          <a href={w.href} class="group flex flex-col rounded-2xl border border-line bg-sand p-6 md:p-7 transition-colors hover:border-primary/50">
            <span class="font-heading text-3xl font-semibold text-primary/40" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-2 font-heading text-2xl font-semibold text-ink">{w.title}</h3>
            <p class="mt-2 leading-relaxed">{w.text}</p>
            <span class="link-arrow mt-auto pt-5">{w.cta} <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Productos por piso ecológico -->
  <section class="py-20 md:py-24">
    <div class="container-custom">
      <div class="max-w-3xl mb-10">
        <span class="eyebrow">De la chacra a la mesa</span>
        <h2 class="section-heading">Tres pisos, tres despensas</h2>
        <p class="text-lg leading-relaxed">Entre los 2,500 y los 4,800 msnm, cada altura da sus propios productos.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {zones.map((zone) => (
          <div class="rounded-2xl bg-secondary-soft p-6 md:p-8">
            <h3 class="font-heading text-2xl font-semibold text-secondary-dark">{zone.name}</h3>
            <p class="mt-2 leading-relaxed">{zone.text}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {zone.products.map((p) => <li class="rounded-full bg-white px-3 py-1 text-sm text-ink">{p}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
