---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PlaceCard from "../components/PlaceCard.astro";
import type { TouristPlace } from "../types";
import { fetchPlaces } from "../lib/api";

// Fallback usado solo si el CMS no devuelve lugares publicados
const fallbackPlaces: TouristPlace[] = [
  {
    id: "allcaqapata",
    name: "Allcaqapata",
    slug: "allcaqapata",
    description: "Sitio arqueológico con vestigios preincaicos ubicado en las alturas del distrito. Este lugar sagrado fue utilizado por los antiguos Chancas como punto de observación y ceremonias. Desde aquí se aprecia una vista panorámica del valle del río Pampas y las comunidades circundantes.",
    category: "archaeological",
    location: { name: "Alturas de Pomabamba", lat: -13.59, lng: -74.24 },
    images: [],
    howToGetThere: "A 45 minutos caminando desde la plaza de Pomabamba, siguiendo el sendero hacia las alturas. Se recomienda ir con guía local.",
    bestTimeToVisit: "Abril a Octubre (época seca)",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "tururumi",
    name: "Tururumi",
    slug: "tururumi",
    description: "Formación rocosa natural que domina el paisaje andino. Según la tradición oral, este lugar era usado por los antiguos pobladores como punto de vigía. Las rocas tienen formas peculiares que la imaginación local ha asociado con figuras de animales y guardianes ancestrales.",
    category: "natural",
    location: { name: "Sector Tururumi, Pomabamba", lat: -13.58, lng: -74.23 },
    images: [],
    howToGetThere: "A 1 hora de caminata desde Pomabamba por sendero de herradura. Terreno moderadamente empinado.",
    bestTimeToVisit: "Mayo a Septiembre",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "killillin-kuchu",
    name: "Killillin Kuchu",
    slug: "killillin-kuchu",
    description: "Rincón natural conocido por ser hábitat de aves alto andinas, especialmente el cernícalo (killillin en quechua). Este refugio de vida silvestre ofrece la oportunidad de observar especies como lechuzas, perdices y diversas aves de la puna en su hábitat natural.",
    category: "natural",
    location: { name: "Zona alta de María Parado de Bellido", lat: -13.57, lng: -74.25 },
    images: [],
    howToGetThere: "Acceso por camino de herradura desde Ñuñunhuaycco, aproximadamente 1.5 horas de caminata.",
    bestTimeToVisit: "Abril a Noviembre (mejor avistamiento de aves)",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "muyumuyu",
    name: "Muyumuyu",
    slug: "muyumuyu",
    description: "Sitio con vestigios arqueológicos que evidencian la presencia de asentamientos Chancas en la zona. Se pueden observar restos de muros de piedra y terrazas agrícolas ancestrales. El nombre en quechua hace referencia a su forma circular característica.",
    category: "archaeological",
    location: { name: "Sector Muyumuyu", lat: -13.60, lng: -74.22 },
    images: [],
    howToGetThere: "A 30 minutos en vehículo desde Pomabamba, luego 20 minutos de caminata.",
    bestTimeToVisit: "Todo el año, preferible época seca",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "kichkapata",
    name: "Kichkapata",
    slug: "kichkapata",
    description: "Zona de espinos y vegetación nativa que representa el ecosistema típico de la región Quechua. Aquí se encuentran especies como la tara, el molle y la tuna. Es un lugar ideal para conocer la flora medicinal que los pobladores han usado por generaciones.",
    category: "natural",
    location: { name: "Ladera este de Pomabamba", lat: -13.61, lng: -74.21 },
    images: [],
    howToGetThere: "A 25 minutos caminando desde el centro de Pomabamba.",
    bestTimeToVisit: "Febrero a Abril (época de floración)",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "silverio-pata",
    name: "Silverio Pata",
    slug: "silverio-pata",
    description: "Mirador natural que ofrece vistas espectaculares del valle y los nevados circundantes. Es un punto popular para observar el amanecer sobre los Andes y apreciar la extensión del territorio que abarca los tres pisos ecológicos del distrito.",
    category: "natural",
    location: { name: "Alturas de Pomabamba", lat: -13.58, lng: -74.26 },
    images: [],
    howToGetThere: "Sendero de 1.5 horas desde la plaza principal. Se recomienda salir temprano para ver el amanecer.",
    bestTimeToVisit: "Mayo a Octubre (cielos despejados)",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "laplarco",
    name: "Laplarco y Qeccacha",
    slug: "laplarco-qeccacha",
    description: "Sitio histórico donde se ubicó el antiguo asentamiento colonial de Pomabamba. Aquí existió una iglesia católica de la época virreinal, de la cual aún quedan vestigios. Según las crónicas, la población fue trasladada al actual emplazamiento tras el hallazgo milagroso de la imagen de San Francisco.",
    category: "historical",
    location: { name: "Laplarco, borde de carretera", lat: -13.59, lng: -74.23 },
    images: [],
    howToGetThere: "A 15 minutos en vehículo desde Pomabamba, visible desde la carretera principal.",
    bestTimeToVisit: "Todo el año",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "rio-pampas",
    name: "Río Pampas",
    slug: "rio-pampas",
    description: "El majestuoso río Pampas marca el límite sur del distrito y es uno de los principales afluentes del Apurímac. Sus aguas cristalinas descienden desde la laguna de Choclococha en Huancavelica. Es ideal para turismo de aventura, pesca y contemplación de la naturaleza.",
    category: "natural",
    location: { name: "Límite sur del distrito", lat: -13.65, lng: -74.20 },
    images: [],
    howToGetThere: "Acceso por camino de herradura desde Pomabamba, aproximadamente 2 horas de caminata hacia el sur.",
    bestTimeToVisit: "Abril a Noviembre (nivel de agua moderado)",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "templo-san-francisco",
    name: "Templo de San Francisco de Asís",
    slug: "templo-san-francisco",
    description: "Iglesia principal de Pomabamba, construida en honor al patrón del pueblo. Según la leyenda local, la imagen de San Francisco fue encontrada milagrosamente en los puquiales de Pumapuquio y aparecía cada noche en este lugar, lo que motivó la construcción del templo y el traslado del pueblo.",
    category: "cultural",
    location: { name: "Plaza Principal de Pomabamba", lat: -13.6014, lng: -74.2342 },
    images: [],
    howToGetThere: "En la plaza principal de Pomabamba, centro del distrito.",
    bestTimeToVisit: "Todo el año. Especialmente durante la Fiesta Patronal (4 de Octubre)",
    entryFee: 0,
    currency: "PEN"
  },
  {
    id: "tacsaorcco",
    name: "Tacsaorcco",
    slug: "tacsaorcco",
    description: "Cerro emblemático que domina el paisaje del distrito. En sus laderas se pueden encontrar restos de andenes preincaicos y es hogar de fauna silvestre como vizcachas y zorros andinos. La cima ofrece una vista de 360° del territorio distrital.",
    category: "natural",
    location: { name: "Cerro Tacsaorcco", lat: -13.56, lng: -74.24 },
    images: [],
    howToGetThere: "Ascenso de 2-3 horas desde Pomabamba. Se recomienda guía local y buena condición física.",
    bestTimeToVisit: "Mayo a Septiembre",
    entryFee: 0,
    currency: "PEN"
  }
];

// Contenido desde el CMS; si no hay lugares publicados, usa el fallback
const dbPlaces = await fetchPlaces();
const touristPlaces = dbPlaces.length ? dbPlaces : fallbackPlaces;

// Agrupar por categoría
const naturalPlaces = touristPlaces.filter(p => p.category === "natural");
const archaeologicalPlaces = touristPlaces.filter(p => p.category === "archaeological");
const historicalPlaces = touristPlaces.filter(p => p.category === "historical");
const culturalPlaces = touristPlaces.filter(p => p.category === "cultural");

// SEO Keywords para sitios turísticos
const placesKeywords = [
  "lugares turísticos Ayacucho",
  "sitios arqueológicos Chancas",
  "turismo María Parado de Bellido",
  "qué visitar en Cangallo",
  "miradores Andes Perú",
  "río Pampas turismo",
  "atractivos turísticos Ayacucho",
  "Allcaqapata Pomabamba",
  "Tururumi Ayacucho",
  "ecoturismo Cangallo",
];

// Breadcrumbs
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Sitios Turísticos", url: "/places" },
];

// Generar Place schema para cada lugar turístico
const placeSchemas = touristPlaces.map((place) => ({
  type: "place" as const,
  data: place,
}));

// ItemList schema para la lista de lugares
const placesStructuredData = [
  {
    type: "itemList" as const,
    data: {
      name: "Sitios Turísticos de María Parado de Bellido",
      description: "Guía completa de atractivos turísticos del distrito María Parado de Bellido: sitios arqueológicos, paisajes naturales, lugares históricos y culturales en Ayacucho, Perú.",
      items: touristPlaces.map((p) => ({
        name: p.name,
        description: p.description,
        url: `/places#${p.slug}`,
        image: p.images?.[0],
      })),
    },
  },
  ...placeSchemas,
];
---

<BaseLayout
  title="Sitios Turísticos - María Parado de Bellido"
  description="Descubre los atractivos turísticos de María Parado de Bellido: sitios arqueológicos Chancas, miradores naturales, el río Pampas y lugares históricos en los Andes de Ayacucho."
  image="/images/default-photo.webp"
  keywords={placesKeywords}
  breadcrumbs={breadcrumbs}
  structuredData={placesStructuredData}
>
  <PageHeader
    title="Sitios Turísticos"
    subtitle="Descubre los tesoros escondidos entre los Andes ayacuchanos"
    icon="🗺️"
    variant="gradient"
  />

  <!-- Intro Section -->
  <section class="container-custom py-12 md:py-16">
    <div class="max-w-4xl mx-auto text-center reveal">
      <p class="text-evocative text-xl">
        María Parado de Bellido cuenta con <span class="text-verde-dark font-bold">atractivos turísticos</span> de corte
        <span class="text-terracota font-semibold">arqueológico</span>, <span class="text-azul font-semibold">natural</span> e
        <span class="text-purpura font-semibold">histórico</span>. Desde vestigios de la cultura Chanca hasta
        impresionantes paisajes andinos, cada rincón guarda una historia milenaria esperando ser descubierta.
      </p>
    </div>
  </section>

  <!-- Natural Places -->
  <section class="relative py-12 md:py-16 bg-gradient-to-b from-verde/5 to-transparent">
    <div class="container-custom">
      <div class="text-center mb-10 reveal">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-verde/10 text-verde-dark rounded-full text-sm font-semibold mb-4">
          <span>🏔️</span> Naturaleza
        </span>
        <h2 class="section-heading">Paisajes Naturales</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Miradores, formaciones rocosas y ecosistemas únicos entre los 2,500 y 4,800 msnm
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {naturalPlaces.map((place) => (
          <div class="reveal">
            <PlaceCard place={place} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Archaeological Places -->
  <section class="relative py-12 md:py-16">
    <div class="container-custom">
      <div class="text-center mb-10 reveal">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-purpura/10 text-purpura-dark rounded-full text-sm font-semibold mb-4">
          <span>🏺</span> Arqueología
        </span>
        <h2 class="section-heading">Sitios Arqueológicos</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Vestigios de la cultura Chanca que dominó estos territorios entre los años 1200 y 1400 d.C.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {archaeologicalPlaces.map((place) => (
          <div class="reveal">
            <PlaceCard place={place} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Historical & Cultural Places -->
  <section class="relative py-12 md:py-16 bg-gradient-to-b from-terracota/5 to-transparent">
    <div class="container-custom">
      <div class="text-center mb-10 reveal">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-terracota/10 text-terracota-dark rounded-full text-sm font-semibold mb-4">
          <span>🏛️</span> Historia y Cultura
        </span>
        <h2 class="section-heading">Lugares Históricos y Culturales</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Testimonios de la época colonial y la fe que forjó la identidad del pueblo
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {[...historicalPlaces, ...culturalPlaces].map((place) => (
          <div class="reveal">
            <PlaceCard place={place} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Info Section -->
  <section class="container-custom py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gradient-to-br from-azul/5 via-turquesa/5 to-verde/5 rounded-3xl p-8 md:p-10 reveal">
        <h3 class="font-heading font-bold text-2xl text-gray-800 mb-6 text-center">
          Recomendaciones para tu Visita
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <div class="w-12 h-12 bg-amarillo/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">🌤️</span>
            </div>
            <div>
              <h4 class="font-semibold text-gray-800 mb-1">Mejor Época</h4>
              <p class="text-sm text-gray-600">Abril a Octubre (época seca). Cielos despejados y caminos accesibles.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-12 h-12 bg-verde/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">🥾</span>
            </div>
            <div>
              <h4 class="font-semibold text-gray-800 mb-1">Equipamiento</h4>
              <p class="text-sm text-gray-600">Calzado de trekking, protector solar, agua y ropa abrigadora para las alturas.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-12 h-12 bg-turquesa/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">🧭</span>
            </div>
            <div>
              <h4 class="font-semibold text-gray-800 mb-1">Guías Locales</h4>
              <p class="text-sm text-gray-600">Recomendamos contratar guías de la comunidad que conocen los senderos y la historia.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-12 h-12 bg-fucsia/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">🏔️</span>
            </div>
            <div>
              <h4 class="font-semibold text-gray-800 mb-1">Altitud</h4>
              <p class="text-sm text-gray-600">Estamos entre 2,500 y 4,800 msnm. Aclimatarse antes de caminatas exigentes.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-verde-jade to-turquesa text-white py-12 md:py-16 pattern-overlay">
    <div class="container-custom text-center reveal">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">
        ¿Listo para Explorar?
      </h2>
      <p class="text-lg mb-6 max-w-2xl mx-auto text-white/90">
        Contáctanos por WhatsApp y te conectamos con guías locales que conocen cada historia y sendero.
      </p>
      <a
        href="/festivities"
        class="inline-flex items-center justify-center px-8 py-4 rounded-full font-semibold
               bg-white text-verde-dark border-2 border-white
               hover:bg-transparent hover:text-white
               transition-all duration-300 transform hover:scale-105
               focus:outline-none focus:ring-4 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-turquesa"
      >
        Ver Festividades
      </a>
    </div>
  </section>
</BaseLayout>
