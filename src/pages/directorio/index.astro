---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BusinessCard from "../../components/BusinessCard.astro";
import type { Business } from "../../types";
import { fetchBusinesses } from "../../lib/api";
import { whatsappUrl } from "../../lib/whatsapp";

// Negocios solo desde el CMS. No hay datos de ejemplo: se publicarían teléfonos y WhatsApp
// inventados que pueden ser de personas reales. Cada negocio debe autorizar su publicación.
const businesses = await fetchBusinesses();
const hasBusinesses = businesses.length > 0;

// Agrupar por categoría
const categories = [
  { key: "hostal", label: "Hospedajes", icon: "🏨" },
  { key: "restaurante", label: "Restaurantes", icon: "🍽️" },
  { key: "tienda", label: "Tiendas", icon: "🛒" },
  { key: "transporte", label: "Transporte", icon: "🚐" },
  { key: "artesania", label: "Artesanía", icon: "🎨" },
  { key: "servicio", label: "Servicios", icon: "⚙️" },
] as const;

const businessesByCategory = categories.map(cat => ({
  ...cat,
  items: businesses.filter(b => b.category === cat.key)
}));

// SEO Keywords para directorio
const directorioKeywords = [
  "hospedajes María Parado de Bellido",
  "restaurantes Pomabamba",
  "hoteles Cangallo Ayacucho",
  "dónde comer en María Parado de Bellido",
  "transporte a Pomabamba",
  "artesanías Ayacucho",
  "guía turístico Cangallo",
  "servicios turísticos Ayacucho",
  "alojamiento rural Perú",
  "turismo comunitario Ayacucho",
];

// Breadcrumbs
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Servicios", url: "/directorio/" },
];

// Generar LocalBusiness schema para cada negocio verificado
const verifiedBusinesses = businesses.filter(b => b.isVerified);
const businessSchemas = verifiedBusinesses.map((business) => ({
  type: "localBusiness" as const,
  data: business,
}));

// ItemList schema para el directorio
const directorioStructuredData = hasBusinesses ? [
  {
    type: "itemList" as const,
    data: {
      name: "Directorio de Negocios de María Parado de Bellido",
      description: "Guía completa de hospedajes, restaurantes, tiendas, transporte, artesanía y servicios en el distrito María Parado de Bellido, Cangallo, Ayacucho.",
      items: businesses.map((b) => ({
        name: b.name,
        description: b.description,
        url: `/directorio/#${b.category}`,
      })),
    },
  },
  ...businessSchemas,
] : [];

const buscarMensaje = "Hola, busco hospedaje, comida o transporte en Pomabamba. ¿Qué me recomiendan?";
const registerUrl = whatsappUrl("Hola, tengo un negocio en Pomabamba y quiero aparecer en la sección de servicios de la web.");
---

<BaseLayout
  title="Servicios en Pomabamba: hospedaje, comida y transporte"
  description="Encuentra hospedajes, restaurantes, tiendas, transporte y servicios en el distrito María Parado de Bellido, Cangallo, Ayacucho."
  image="/images/hero_1.webp"
  keywords={directorioKeywords}
  breadcrumbs={breadcrumbs}
  structuredData={directorioStructuredData}
  whatsappMessage={buscarMensaje}
>
  <PageHero
    eyebrow="Servicios"
    title="Todo para tu estadía"
    intro="Hospedajes, restaurantes, transporte y servicios de emprendedores locales comprometidos con el desarrollo del distrito."
    image="/images/hero_1.webp"
    imageAlt="Vista panorámica de Pomabamba"
    breadcrumbs={breadcrumbs}
  />

  {!hasBusinesses && (
    <section class="py-16 md:py-20">
      <div class="container-custom">
        <div class="rounded-2xl border border-dashed border-line bg-white p-8 md:p-10 max-w-3xl">
          <span class="eyebrow">Próximamente</span>
          <h2 class="font-heading text-3xl font-semibold leading-tight text-ink">Estamos sumando a los negocios del distrito</h2>
          <p class="mt-3 text-lg leading-relaxed">
            Pronto encontrarás aquí hospedajes, restaurantes, transporte y otros servicios de Pomabamba. Mientras
            tanto, escríbenos y te ayudamos a organizar tu estadía.
          </p>
          <a href={whatsappUrl(buscarMensaje)} target="_blank" rel="noopener noreferrer" class="btn-primary mt-6">Escríbenos por WhatsApp</a>
        </div>
      </div>
    </section>
  )}

  {hasBusinesses && <nav aria-label="Categorías" class="sticky top-[80px] md:top-[92px] z-40 bg-sand/95 backdrop-blur border-b border-line">
    <ul class="container-custom flex gap-2 overflow-x-auto py-3 text-sm">
      {businessesByCategory.filter((c) => c.items.length > 0).map((cat) => (
        <li>
          <a href={`#${cat.key}`} class="block whitespace-nowrap rounded-full border border-line bg-white px-4 py-1.5 font-medium text-ink hover:border-primary hover:text-primary transition-colors">
            {cat.label} <span class="text-ink-soft">({cat.items.length})</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>}

  {businessesByCategory.map((category, i) => category.items.length > 0 && (
    <section id={category.key} class:list={["py-16 md:py-20 scroll-mt-40", i % 2 === 1 && "bg-white"]}>
      <div class="container-custom">
        <div class="flex items-baseline gap-3 mb-8">
          <h2 class="section-heading mb-0">{category.label}</h2>
          <span class="text-sm">
            {category.items.length} {category.items.length === 1 ? "negocio" : "negocios"}
          </span>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {category.items.map((business) => (
            <BusinessCard business={business} />
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="py-16 md:py-20">
    <div class="container-custom">
      <div class="rounded-3xl bg-secondary text-white p-8 md:p-14 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2">
          <h2 class="font-heading text-3xl md:text-4xl font-semibold !text-white mb-3">¿Tienes un negocio en el distrito?</h2>
          <p class="text-white/85 text-lg">
            Si eres emprendedor local y deseas que tu negocio aparezca en este directorio, comunícate con
            nosotros. Es completamente gratuito para los negocios del distrito.
          </p>
        </div>
        <div class="flex md:justify-end">
          <a href={registerUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost-light">Registrar mi negocio</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="container-custom">
      <SectionHeading
        eyebrow="Tu visita"
        title="¿Listo para conocer María Parado de Bellido?"
        intro="Te ayudamos a planificar tu visita para descubrir la riqueza cultural, histórica y natural del distrito."
      />
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/planifica-tu-visita/" class="btn-primary">Planifica tu visita</a>
        <a href="/lugares/" class="btn-secondary">Explorar destinos</a>
      </div>
    </div>
  </section>
</BaseLayout>
