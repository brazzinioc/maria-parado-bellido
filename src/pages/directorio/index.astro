  },
  {
    id: "5",
    name: "Recreo Campestre El Molle",
    slug: "recreo-campestre-el-molle",
    category: "restaurante",
    description: "Restaurante campestre con amplios jardines y zona de juegos para niños. Pachamanca los domingos bajo pedido. Trucha frita del río Pampas.",
    address: "Carretera a Urihuana, Km 2",
    whatsapp: "51966567890",
