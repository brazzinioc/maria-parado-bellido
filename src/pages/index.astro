---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PhotoCard from "../components/PhotoCard.astro";
import WeatherStat from "../components/WeatherStat";
import HeroSlider from "../components/HeroSlider";
import InteractiveMap from "../components/InteractiveMap";
import { fetchFestivities, fetchPlaces } from "../lib/api";
import { festivityCoverImage } from "../lib/placeholders";
import { getExperiences, getGallery } from "../lib/content";
import { placeCategoryLabel, placeCoverImage, hasCoordinates } from "../lib/places";

// --- Hero anterior (CMS + fallback de imágenes) ---
// Deshabilitado: el hero ahora es estático (ver heroSlides más abajo).
// Se deja comentado por si se vuelve a usar más adelante.
// import { fetchHeroSlides } from "../lib/api";
// const fallbackHeroSlides = [
//   { image: "/images/hero_1.webp", alt: "Vista panorámica de Pomabamba con campos de cultivo andinos" },
//   { image: "/images/hero_2.webp", alt: "Cordillera andina y paisajes de María Parado de Bellido" },
//   { image: "/images/hero_3.webp", alt: "Tradiciones y cultura viva en Pomabamba" },
//   { image: "/images/hero_4.webp", alt: "Naturaleza y ecosistemas del distrito" },
//   { image: "/images/hero_5.webp", alt: "Vida comunitaria en los Andes de Ayacucho" },
// ];
// const dbHeroSlides = await fetchHeroSlides();
// const heroSlides = dbHeroSlides.length ? dbHeroSlides : fallbackHeroSlides;

const [festivities, places, experiences, gallery] = await Promise.all([
  fetchFestivities(),
  fetchPlaces(),
  getExperiences(),
  getGallery(),
]);

// Hero estático: video de dron (DJI Neo 2) a 0.5x de velocidad.
// Clip completo (55s originales -> ~110s a 0.5x).
// `image` funciona como poster/fallback: es lo que se pinta de inmediato
// y lo que ven quienes tienen prefers-reduced-motion, conexión lenta/con
// ahorro de datos, o si el video falla. Video H.264 a 1280x720 (~9 MB) y
// variante `mobileVideo` a 854x480 (~5 MB) para viewports angostos.
const heroSlides = [
  {
    type: "video" as const,
    image: "/images/hero-dron-pomabamba-ayacucho.webp",
    video: "/media/vuelo-dron-pomabamba-ayacucho-720p.mp4",
    mobileVideo: "/media/vuelo-dron-pomabamba-ayacucho-480p.mp4",
    alt: "Vuelo de dron sobre Pomabamba, María Parado de Bellido",
  },
];

// Próximas fiestas: las que aún no terminan; si el CMS solo tiene fechas pasadas, las más recientes.
const byStart = [...festivities].sort((a, b) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime());
const notOver = byStart.filter((f) => new Date(f.end_date).getTime() >= Date.now() - 86400000);
const upcomingFestivities = (notOver.length ? notOver : byStart).slice(0, 3);

const featuredPlaces = places.slice(0, 5);
const mapPlaces = places.filter(hasCoordinates);
const mapMarkers = mapPlaces.map((p) => ({
  id: p.id,
  title: p.name,
  type: "place" as const,
  slug: p.slug,
  image: p.images?.[0],
  name: p.location.name,
  lat: p.location.lat,
  lng: p.location.lng,
}));

const galleryItems = gallery.slice(0, 6);

const formatDay = (date: string) =>
  new Date(date).toLocaleDateString("es-PE", { day: "2-digit", month: "short", timeZone: "UTC" }).replace(".", "");

const heroStats = [
  { value: "3,236", label: "msnm" },
  { value: "3", label: "ecosistemas" },
  { value: "3 h", label: "desde Ayacucho" },
];

// SEO Keywords específicos para Home
const homeKeywords = [
  "turismo vivencial Ayacucho",
  "trekking Ayacucho",
  "cicloturismo Ayacucho",
  "Pomabamba turismo",
  "qué hacer en Cangallo",
  "destinos turísticos Ayacucho",
  "turismo rural comunitario",
  "cultura Chanca",
];

const homeStructuredData = [
  {
    type: "touristDestination" as const,
    data: {
      description:
        "Pomabamba, capital del distrito María Parado de Bellido, es un destino andino a 3,236 msnm en Cangallo, Ayacucho: trekking, cicloturismo, turismo vivencial, festividades tradicionales y gastronomía local.",
      image: "/images/hero_1.webp",
      attractions: places.slice(0, 6).map((p) => ({ name: p.name, description: p.description })),
    },
  },
];
---

<BaseLayout
  title="Pomabamba, Ayacucho: trekking, cultura y turismo vivencial"
  description="Descubre Pomabamba y María Parado de Bellido: trekking, cicloturismo, turismo vivencial, fiestas y gastronomía a 3,236 msnm en Cangallo, Ayacucho."
  image="/images/hero_1.webp"
  keywords={homeKeywords}
  structuredData={homeStructuredData}
>
  <!-- La foto del hero es lo primero que se ve (LCP): se pide antes que el resto.
       Las variantes -480w…-1600w las genera tools/responsive-images.mjs. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/hero-dron-pomabamba-ayacucho.webp"
    imagesrcset="/images/hero-dron-pomabamba-ayacucho-480w.webp 480w, /images/hero-dron-pomabamba-ayacucho-800w.webp 800w, /images/hero-dron-pomabamba-ayacucho-1200w.webp 1200w, /images/hero-dron-pomabamba-ayacucho-1600w.webp 1600w, /images/hero-dron-pomabamba-ayacucho.webp 1920w"
    imagesizes="100vw"
    fetchpriority="high"
  />

  <!-- 1. Hero cinematográfico -->
  <section id="home-hero" class="relative h-dvh min-h-[640px] -mt-20 md:-mt-[92px] overflow-hidden w-full max-w-[100vw]">
    <img
      src={heroSlides[0].image}
      alt={heroSlides[0].alt}
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover object-bottom"
    />
    <HeroSlider client:idle slides={heroSlides} autoPlayInterval={6500} />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/45 to-ink/15" aria-hidden="true"></div>
    <!-- Scrim: oscurece solo la esquina inferior izquierda, donde vive el texto, -->
    <!-- para dar contraste sin apagar el resto del video ni recurrir a sombras. -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgb(0_0_0/0.55)_0%,transparent_60%)]" aria-hidden="true"></div>

    <div class="absolute inset-0 z-10 flex items-end pt-20 md:pt-[92px]">
      <div class="container-custom w-full pb-10 md:pb-16">
        <div class="max-w-3xl">
          <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.3em] text-white/80 mb-4">
            Pomabamba · Cangallo · Ayacucho, Perú
          </p>
          <h1 class="font-heading font-semibold !text-white text-5xl md:text-7xl leading-[1.02] mb-5 [text-shadow:0_1px_2px_rgb(0_0_0/0.25)]">
            Donde los Andes guardan sus secretos
          </h1>
          <p class="text-lg md:text-xl text-white/90 mb-8">
            Tierra chanca sobre el valle del río Pampas.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/lugares/" class="btn-primary">
              Explorar destinos
            </a>
            <a href="/planifica-tu-visita/" class="btn-ghost-light">
              Planifica tu visita
            </a>
          </div>
        </div>

        <!-- Indicadores: desde tablet (md) hacia arriba van dentro del hero. -->
        <!-- En mobile viven aparte, ver sección 1b. -->
        <div class="hidden md:flex mt-14 pt-6 border-t border-white/20 flex-wrap items-center gap-x-10 gap-y-4 md:pr-48">
          {heroStats.map((stat) => (
            <div class="text-white">
              <span class="font-heading text-2xl md:text-3xl font-semibold">{stat.value}</span>
              <span class="ml-1.5 text-sm text-white/75">{stat.label}</span>
            </div>
          ))}
          <WeatherStat client:idle variant="dark" />
        </div>
      </div>
    </div>
  </section>

  <!-- 1b. Franja de indicadores: solo en mobile (ver arriba para tablet/desktop) -->
  <section class="bg-crema border-b border-line md:hidden">
    <div class="container-custom py-5 flex flex-wrap items-center gap-x-10 gap-y-3">
      {heroStats.map((stat) => (
        <div class="text-ink">
          <span class="font-heading text-xl md:text-2xl font-semibold">{stat.value}</span>
          <span class="ml-1.5 text-sm text-ink-soft">{stat.label}</span>
        </div>
      ))}
      <div class="sm:ml-auto">
        <WeatherStat client:idle variant="light" />
      </div>
    </div>
  </section>

  <!-- 2. Experiencias -->
  <section class="py-20 md:py-28">
    <div class="container-custom">
      <SectionHeading
        eyebrow="Experiencias"
        title="Vive los Andes de María Parado de Bellido"
        intro="Camina sus senderos, recórrelo en bicicleta o comparte la vida de sus comunidades."
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {experiences.map((exp) => (
          <PhotoCard
            href={`/experiencias/${exp.slug}/`}
            image={exp.image}
            alt={exp.imageAlt}
            title={exp.title}
            subtitle={exp.tagline}
            cta="Descubrir"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Destinos -->
  {featuredPlaces.length > 0 && (
    <section class="py-20 md:py-28 bg-white">
      <div class="container-custom">
        <SectionHeading
          eyebrow="Destinos"
          title="Lugares que tienes que conocer"
          align="left"
        >
          <a slot="actions" href="/lugares/" class="btn-secondary">Ver todos los destinos</a>
        </SectionHeading>
        <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-5 md:gap-6 md:h-[640px]">
          {featuredPlaces.map((place, i) => (
            <PhotoCard
              href={`/lugares/${place.slug}/`}
              image={placeCoverImage(place)}
              alt={place.name}
              title={place.name}
              subtitle={placeCategoryLabel(place.category)}
              meta={place.location.name || "Pomabamba"}
              size="fill"
              class={i === 0 ? "md:col-span-2 md:row-span-2" : ""}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 4. Storytelling -->
  <section class="py-20 md:py-28">
    <div class="container-custom grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="relative aspect-[4/3] rounded-2xl overflow-hidden lg:col-span-7">
        <img
          src="/images/comparsa-carnaval-pomabamba-ayacucho.webp"
          alt="Comparsa de carnaval con ponchos, banderas y máscaras recorriendo la plaza de Pomabamba, Ayacucho"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
      <div class="max-w-xl lg:col-span-5">
        <span class="eyebrow">Nuestra identidad</span>
        <h2 class="section-heading">Más que visitar, es vivir</h2>
        <p class="text-lg leading-relaxed mb-5">
          En Pomabamba las tradiciones no se guardan en vitrinas: se bailan en carnavales y fiestas patronales,
          se tejen en mantas, chumpis y ponchos, y se comparten en la chacra.
        </p>
        <p class="leading-relaxed mb-8">
          Somos herederos de la cultura Chanca y llevamos el nombre de
          <strong class="text-ink">María Parado de Bellido</strong>, heroína de la Independencia. Aquí el
          <strong class="text-ink">ayni</strong> y la <strong class="text-ink">minka</strong> siguen uniendo a la
          comunidad en el trabajo y en la fiesta.
        </p>
        <a href="/historia/" class="link-arrow">
          Conoce nuestra historia
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Festividades -->
  {upcomingFestivities.length > 0 && (
    <section class="py-20 md:py-28 bg-white">
      <div class="container-custom">
        <SectionHeading eyebrow="Calendario festivo" title="Vive nuestras fiestas" align="left">
          <a slot="actions" href="/festividades/" class="btn-secondary">Ver calendario completo</a>
        </SectionHeading>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
          {upcomingFestivities.map((fest) => (
            <PhotoCard
              href={`/festividades/${fest.slug}/`}
              image={festivityCoverImage(fest)}
              alt={fest.name}
              title={fest.name}
              badge={formatDay(fest.start_date)}
              meta={fest.place?.name}
              cta="Ver programa"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 6. Gastronomía -->
  <section class="py-20 md:py-28">
    <div class="container-custom grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="max-w-xl lg:order-2">
        <span class="eyebrow">Gastronomía</span>
        <h2 class="section-heading">Sabores de nuestra tierra</h2>
        <p class="text-lg leading-relaxed mb-5">
          En nuestra mesa todo viene de la chacra: papas nativas, habas, maíz, quinua y el queso fresco
          que las familias elaboran con la leche del día.
        </p>
        <p class="leading-relaxed mb-8">
          Con ellos se preparan la <strong class="text-ink">pachamanca</strong>, el
          <strong class="text-ink">puca picante</strong> y los platos que acompañan cada faena y cada fiesta.
        </p>
        <a href="/gastronomia/" class="btn-primary">Descubre nuestra gastronomía</a>
      </div>
      <div class="relative aspect-[4/5] lg:aspect-[5/6] rounded-2xl overflow-hidden lg:order-1">
        <img
          src="/images/gastronomia-andina-queso-habas-maiz-papa-nativa-pomabamba.webp"
          alt="Mano sirviendo queso fresco con ají y cebolla junto a habas, maíz y papas nativas, gastronomía andina de Pomabamba, Ayacucho"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover object-[center_45%]"
        />
      </div>
    </div>
  </section>

  <!-- 7. Comunidad -->
  <section class="relative py-20 md:py-28 bg-secondary text-white overflow-hidden">
    <div class="container-custom grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="max-w-xl">
        <span class="eyebrow !text-accent-light">Nuestra gente</span>
        <h2 class="section-heading !text-white">Conoce nuestra gente</h2>
        <p class="text-lg leading-relaxed text-white/85 mb-8">
          En Pomabamba el quechua sigue siendo la lengua de casa. Somos un pueblo joven, de familias que volvieron
          a su tierra para sembrarla de nuevo. Visítanos con respeto, saluda con un <em>allillanchu</em> y comparte
          con nosotros.
        </p>
        <a href="/comunidad/" class="btn-ghost-light">Ver agenda del distrito</a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="relative aspect-[3/4] overflow-hidden rounded-2xl">
          <img src="/images/agricultor-maiz-nativo-feria-pomabamba-ayacucho.webp" alt="Agricultor con poncho y sombrero mostrando mazorcas de maíz nativo de colores en una feria de Pomabamba, Ayacucho" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
        </div>
        <div class="relative aspect-[3/4] overflow-hidden rounded-2xl mt-10">
          <img src="/images/comuneros-caballos-ponchos-puna-pomabamba-ayacucho.webp" alt="Comuneros con ponchos y sus caballos reunidos en la puna de Pomabamba, Ayacucho" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Mapa -->
  {mapPlaces.length > 0 && (
    <section class="py-20 md:py-28 bg-white">
      <div class="container-custom">
        <SectionHeading
          eyebrow="Guía del territorio"
          title="Explora María Parado de Bellido"
          intro="Ubica cada destino y planifica tu recorrido."
        />
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <InteractiveMap
            client:visible
            markers={mapMarkers}
            center={[mapPlaces[0].location.lat, mapPlaces[0].location.lng]}
            zoom={12}
            className="lg:col-span-2 h-[420px] md:h-[520px]"
          />
          <ul class="space-y-3 lg:max-h-[520px] lg:overflow-y-auto">
            {mapPlaces.map((place) => (
              <li>
                <a href={`/lugares/${place.slug}/`} class="group flex items-center gap-4 rounded-2xl border border-line p-3 hover:border-primary/40 transition-colors">
                  <img src={placeCoverImage(place)} alt="" loading="lazy" class="h-16 w-16 rounded-xl object-cover" />
                  <div>
                    <p class="font-semibold text-ink group-hover:text-primary">{place.name}</p>
                    <p class="text-sm">{placeCategoryLabel(place.category)}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- 9. Galería -->
  {galleryItems.length > 0 && (
    <section class="py-20 md:py-28">
      <div class="container-custom">
        <SectionHeading eyebrow="Galería" title="Momentos de María Parado de Bellido" />
        <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-[160px] md:auto-rows-[220px] gap-3 md:gap-4">
          {galleryItems.map((item, i) => (
            <figure
              class:list={[
                "group relative overflow-hidden rounded-2xl",
                i === 0 && "col-span-2 row-span-2",
                i === 3 && "md:row-span-2",
              ]}
            >
              <img src={item.image} alt={item.alt} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              {item.caption && (
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 to-transparent p-3 pt-8 text-sm font-medium text-white opacity-0 group-hover:opacity-100 transition-opacity">
                  {item.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 10. CTA final -->
  <section class="relative py-28 md:py-36 overflow-hidden">
    <img src="/images/hero_1.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-ink/70" aria-hidden="true"></div>
    <div class="container-custom relative text-center">
      <span class="eyebrow !text-accent-light">Tu próxima aventura</span>
      <h2 class="section-heading !text-white max-w-3xl mx-auto">¿Listo para descubrir los Andes?</h2>
      <p class="text-lg md:text-xl text-white/85 mb-10 max-w-2xl mx-auto">
        A solo unas horas de Ayacucho comienza una experiencia diferente. Quien viene a Pomabamba, siempre vuelve.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/lugares/" class="btn-primary">Explorar destinos</a>
        <a href="/planifica-tu-visita/" class="btn-ghost-light">Planificar mi visita</a>
      </div>
    </div>
  </section>
</BaseLayout>
