];

const climateFacts = [
  { label: "Tipo", value: "Sierra - Seco y frío" },
  { label: "Temperatura", value: "-4.4°C a 24.2°C" },
  { label: "Precipitación", value: "700-1,150 mm anuales" },
  { label: "Humedad", value: "46% - 70%" },
  { label: "Época lluviosa", value: "Noviembre - Marzo" },
  { label: "Época seca", value: "Abril - Octubre" },
];

const ecoZones = [
  { name: "Zona Quechua", description: "Cultivos de maíz, papa, trigo y frutales" },
  { name: "Zona Suni", description: "Ganadería y cultivos de quinua, kiwicha" },
  { name: "Zona Puna", description: "Pastos naturales y camélidos" },
];

const communities = [
  { name: "Pomabamba", meta: "Capital distrital • 2,822.19 Has • 3,170 msnm", detail: "Anexos: Ccachccara, San Miguel de Acco, San Martín de Ccoriacc, Huascarpampa, Ccasanccay y Tucre" },
  { name: "Urihuana", meta: "963.62 Has • 3,170 msnm", detail: "Barrios: Llullucha Pizara, Carapuma, Tancarpampa" },
  { name: "Santa Cruz de Ñuñunhuaycco", meta: "Centro Poblado Menor • 4,380.81 Has • 3,500 msnm", detail: "Barrios: Mayocancha, Capillapata, Haciendapata, Calvario y Callpana" },
  { name: "Huayllabamba", meta: "1,100 Has • 3,175 msnm", detail: "Barrio: Roccray" },
