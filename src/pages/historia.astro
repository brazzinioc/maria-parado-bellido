const culture = [
  { title: "Ayni y Minka", text: "El <strong>ayni</strong> (reciprocidad) y la <strong>minka</strong> (trabajo colectivo) perviven especialmente en nuestras <strong>fiestas patronales y costumbristas</strong>. Durante estas celebraciones, la comunidad participa voluntariamente y los <strong>cargontes</strong> retribuyen con comida, chicha de jora y música, manteniendo vivo el espíritu de reciprocidad andina." },
  { title: "Folklore", text: "Nuestras expresiones artísticas incluyen el <strong>Chinlili, Chimaycha, Qacchwa</strong>, el toril, las rejoneras y los wacqrapukus. Estas danzas y músicas se relacionan con las actividades agrícolas y las fiestas religiosas." },
  { title: "Economía agropecuaria", text: "El <strong>76%</strong> de nuestra población se dedica a agricultura y ganadería. Cultivamos <strong>papa, maíz, cebada, trigo, quinua, kiwicha</strong> y frutales. Criamos <strong>7,920 cabezas de ganado</strong> entre ovinos (54%), vacunos (18.8%) y camélidos." },
  { title: "Flora y fauna", text: "Bosques de <strong>queñua, molle, tara, eucalipto</strong> y plantas como cabuya y tuna. Fauna: <strong>vizcacha, zorro andino, taruca, puma</strong>, cuy silvestre y aves como el cernícalo (killillin) y lechuzas. El 72% del ambiente está conservado." },
