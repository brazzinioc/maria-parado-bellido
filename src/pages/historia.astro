---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

// SEO Keywords para página de historia
const aboutKeywords = [
  "historia de Pomabamba",
  "Pomabamba Ayacucho",
  "Pomabamba Cangallo",
  "Tukri Apu Urqu",
  "Cangallo independencia",
  "historia María Parado de Bellido",
  "heroína independencia Perú",
  "cultura Chanca Ayacucho",
  "Pomabamba historia",
  "pueblos andinos historia",
  "patrimonio cultural Ayacucho",
  "María Parado de Bellido biografía",
  "Cangallo historia",
  "independencia del Perú",
  "1822 fusilamiento",
];

// Breadcrumbs
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Nuestra historia", url: "/historia" },
];

// Article schema para contenido histórico
const aboutStructuredData = [
  {
    type: "article" as const,
    data: {
      title: "Historia de Pomabamba, Ayacucho: de los Chancas a María Parado de Bellido",
      description: "Historia de Pomabamba, Ayacucho: el templo Tukri – Apu Urqu, los Chancas, la resistencia de Cangallo y la heroína María Parado de Bellido.",
      url: "/historia",
      image: "/images/comuneros-caballos-ponchos-puna-pomabamba-ayacucho.webp",
      section: "Historia",
      keywords: aboutKeywords,
      publishedTime: "2024-01-01T00:00:00Z",
      modifiedTime: new Date().toISOString(),
    },
  },
];

// Reseña histórica. Fuente: Plan de Desarrollo Concertado del Distrito 2007-2022.
const chapters = [
  {
    "era": "10,000 a.C. – 1200 d.C.",
    "title": "Los Primeros Habitantes de Ayacucho y del Valle del Pampas",
    "summary": "Hace más de 10,000 años llegaron los primeros pobladores. En Pomabamba se levantó el templo de Tukri – Apu Urqu; después florecieron el Reino Warpa y el Imperio Wari.",
    "highlights": [
      "Pikimachay",
      "Tukri – Apu Urqu",
      "Reino Warpa",
      "Imperio Wari"
    ],
    "paragraphs": [
      "Las investigaciones realizadas en <strong>Pikimachay</strong> demuestran la presencia de los primeros pobladores de estas tierras alrededor de <strong>10 a 12 mil años A.C.</strong> Se descubrieron vestigios de los primeros agricultores y pastores de camélidos del llamado período formativo hasta los inicios de la era cristiana, donde se encuentran rastros de aldeas.",
      "De ese período Formativo es el testimonio más antiguo de nuestro propio distrito: <a href=\"/lugares/tukri-apu-urqu\"><strong>Tukri – Apu Urqu</strong></a>, a 400 metros de San Cristóbal de Tucre. Fue un centro ceremonial ocupado aproximadamente entre el <strong>800 a.C. y el 100 d.C.</strong>, con tres grandes plataformas de piedra dispuestas en forma de <strong>«U»</strong> alrededor de una plaza hundida, un modelo de templo similar al de <strong>Chavín de Huántar</strong> y al de Campanayuq Rumi, en Vilcashuamán. Su cerámica revela contactos con la costa sur (estilo Paracas) y posiblemente con Chavín, además de un estilo propio, el <strong>«Tukri Rojo»</strong> <a href=\"#fuente-tukri\" class=\"text-ink-soft\">(Tipe Yaranga, 2021)</a>. Es más de mil años anterior a los Chancas. Su nombre quechua alude al cerro donde se posa el Apu, espíritu tutelar que la comunidad sigue respetando.",
      "Los antiguos pobladores de estas zonas alto andinas fueron los <strong>Wilcas</strong>, emigrantes de la lejana cordillera de Vilcabamba, que atravesaron los ríos Apurímac y Mantaro y se asentaron en <strong>Yanawilca</strong>, ocupando los territorios de Huancavelica y Ayacucho (Wilcas Waman).",
      "En los años 200 a 300 D.C. se inicia el período de los reinos locales, siendo el más representativo el <strong>Reino Warpa</strong>, que logró un gran desarrollo tecnológico en agricultura, ganadería de camélidos y textilería. Desarrollaron el control de aguas (infraestructura hidráulica) y uso de tierras (terrazas agrícolas).",
      "Hacia los años 600 y 700 D.C. se intensifican las relaciones culturales regionales con <strong>Nazca</strong> y <strong>Tiahuanaco</strong>, formando el Gran Centro Imperial <strong>Wari</strong>. El Imperio Wari (800 a 1200 D.C.) se desarrolló con mayor auge, hasta su caída con el sojuzgamiento de los Angaraes y Tayacaxas en Huancavelica, los Huancas en el valle del Mantaro, y los <strong>Chancas</strong> en el valle del Pampas."
    ]
  },
  {
    "era": "1200 – 1400",
    "title": "Un Pueblo de Origen Chanca",
    "summary": "Pomabamba tiene raíces Chancas: un pueblo guerrero del valle del Pampas que llegó a cercar el Cusco.",
    "highlights": [
      "Laguna de Choclococha",
      "Inca Wiracocha",
      "Pachacútec"
    ],
    "paragraphs": [
      "<strong>POMABAMBA</strong> es el pueblo más representativo del distrito de María Parado de Bellido. Sus <strong>raíces Chancas</strong> son las más características, con origen en las alturas de la <strong>laguna de Choclococha</strong>, donde nace el río Pampas.",
      "Desde los años <strong>1200 hasta 1400</strong>, los Chancas se extendieron desde Huancavelica hasta los actuales territorios de Ayacucho y Apurímac. Su lengua original aún es materia de debate entre lingüistas; con el tiempo, en la región se impuso el quechua. Desde el valle del río Pampas, realizaron expediciones para conquistar el Cusco, cuando ésta era todavía un reino regional.",
      "Durante el reinado del <strong>Inca Wiracocha</strong>, los Chancas cercaron el Cusco para tomar la ciudad, pero fracasaron. El príncipe <strong>Yupanqui</strong> derrotó a los ejércitos Chancas, y a partir de allí el poder imperial cusqueño se restableció. Yupanqui se convertiría en el noveno emperador Inca con el apelativo <strong>Pachacútec</strong>, gran conquistador y creador del Imperio del Tahuantinsuyo."
    ]
  },
  {
    "era": "1400 – 1530",
    "title": "Bajo el Dominio del Tahuantinsuyo",
    "summary": "Tras su derrota, los Chancas quedaron bajo el poder inca, administrado desde Vilcashuamán.",
    "highlights": [
      "Vilcashuamán",
      "Mitimaes",
      "Tambos"
    ],
    "paragraphs": [
      "A partir de la derrota Chanca, los pueblos fueron sometidos al poder cusqueño (incas, quechuas), quienes se instalaron y construyeron el centro administrativo más importante de toda la región central del imperio: <strong>Vilcashuamán</strong>.",
      "Durante casi cien años, los sacerdotes y nobles cusqueños administraban la ecología, planificaban la producción y enseñaban las técnicas para la buena producción agropecuaria. Los pueblos Chancas fueron trasladados en gran parte a otras zonas y reemplazados por <strong>mitimaes quechuas</strong> para pacificar y asimilar al poder Inka toda la región.",
      "La nobleza cusqueña almacenaba en grandes <strong>tambos</strong> la producción agropecuaria excedente de cada uno de los pueblos de todo el valle del río Pampas. Parte de estos productos alimenticios, pieles, fibra y artesanías eran enviados hasta el Cusco para la nobleza real del imperio.",
      "<strong>Huellas de esta época</strong> existen en la zona de Pomabamba: como en <strong>Moyu Moyu, Laplarco, Tacsa Urcco</strong> y el cementerio en la misma plaza principal, que abarca desde el actual Centro Educativo N° 38131 hasta la Avenida Los Héroes, donde aún se encuentran restos humanos de época prehispánica."
    ]
  },
  {
    "era": "1530 – 1821",
    "title": "El Virreynato: 300 Años de Dominio Colonial",
    "summary": "Tres siglos de dominio colonial transformaron la sociedad andina. Pomabamba se habría fundado en 1651.",
    "highlights": [
      "1533: toma de Vilcashuamán",
      "Corregimientos",
      "1651"
    ],
    "paragraphs": [
      "Alrededor del año 1530, el gran imperio del Tahuantinsuyo entró en crisis debido a las guerras internas entre los ejércitos de <strong>Huáscar</strong> y <strong>Atahualpa</strong>, hijos del Inka Huayna Cápac (nieto de Pachacútec), quienes se disputaban el trono.",
      "En 1531 se produce la llegada de los españoles por la costa norte de Tumbes. En <strong>1533</strong> los españoles tomaron la ciudad de <strong>Vilcashuamán</strong> y comenzaron su presencia colonial en estas tierras. Con los conquistadores europeos se inicia el más devastador proceso de mestizaje que en 300 años transformó esta sociedad y su cultura de adaptación y dominio andino.",
      "A la par se producía la evangelización de los \"indios\" a la religión occidental cristiana y su explotación para la extracción de riqueza minera que luego era enviada hacia Europa. Como consecuencia de la explotación despiadada en las minas y las epidemias de enfermedades, <strong>casi el 90% de la población nativa</strong> murió a lo largo de estos siglos de colonialismo.",
      "A partir de 1550 se crearon los corregimientos. Los ayllus del Valle del Pampas pertenecieron al <strong>Corregimiento de Vilcashuamán</strong> y al <strong>Obispado de Ayacucho</strong>. El pueblo de Pomabamba pudo haberse fundado en <strong>1651</strong>; los pobladores acudían a la mita en las minas de Huancavelica y también a un obraje cerca de Cangallo."
    ]
  },
  {
    "era": "Leyenda",
    "title": "La Leyenda del Traslado del Pueblo",
    "summary": "Una imagen de San Francisco hallada en Pumapuquio motivó el traslado del pueblo a su ubicación actual.",
    "highlights": [
      "Pumapuquio",
      "San Francisco"
    ],
    "paragraphs": [
      "Durante la Colonia, la población de Pomabamba vivía en el lugar denominado <strong>Laplarco y Qeccacha</strong>, donde se construyó una iglesia católica cuyas huellas aún existen en el borde de la carretera, en la chacra de los esposos Luis Ramos y Lucía Arcos.",
      "Según una leyenda de esos tiempos, en los puquiales de la quebrada de <strong>Pumapuquio</strong> (llamada así por la presencia de pumas) encontraron una imagen de <strong>San Francisco</strong>. Cada noche aparecía en el lugar del actual templo; devolvían la imagen pero siempre aparecía en el mismo sitio. Por esta razón, los pobladores indígenas, orientados por los sacerdotes españoles, comenzaron a rendirle culto, construyeron un nuevo templo y el centro poblado fue trasladado al lugar que hoy ocupa con el nombre de Pomabamba."
    ]
  },
  {
    "era": "1821 – 1902",
    "title": "Pomabamba en la Guerra de Independencia",
    "summary": "Cangallo fue tierra de patriotas: tras el incendio de 1821, Pomabamba fue capital provincial; en 1902 fue elevada a Villa.",
    "highlights": [
      "Basilio Auqui Huaytalla",
      "Incendio de Cangallo, 1821",
      "Heroica Villa",
      "Villa en 1902"
    ],
    "paragraphs": [
      "Durante la guerra de Independencia, la provincia de Cangallo fue uno de los focos más decididos de la resistencia patriota. El líder morochuco <strong>Don Basilio Auqui Huaytalla</strong> derrotó a las huestes del Ejército realista el <strong>28 de noviembre de 1821</strong>. En venganza, el general realista <strong>José Carratalá</strong> ordenó incendiar la ciudad de Cangallo el <strong>17 de diciembre de 1821</strong>, convirtiéndola en ruinas y cenizas.",
      "El Virrey La Serna ratificó este nefasto decreto y cambió el nombre de Cangallo a Vilcashuamán, situando la capital en el Pueblo de <strong>Pomabamba</strong>.",
      "En honor a esa resistencia, el general <strong>José de San Martín</strong> ordenó reedificar Cangallo y la llamó <strong>«Heroica Villa»</strong>; tras la independencia, Cangallo recuperó su nombre y su capital, y por ley del 28 de mayo de 1828 recibió el título de <strong>«Heroica Provincia de Santa Rosa de Cangallo»</strong>. De esta misma tierra salió María Parado de Bellido, nacida en Paras, cuya familia luchó en las montoneras patriotas.",
      "Posteriormente, durante el Gobierno de <strong>Eduardo L. de Romaña</strong>, se emitió un decreto el 21 de noviembre de 1902 elevando a la categoría de <strong>\"VILLA\"</strong> al Pueblo de Pomabamba y declarándolo Capital de la Provincia de Cangallo."
    ]
  },
  {
    "era": "1962",
    "title": "Creación del Distrito de María Parado de Bellido",
    "summary": "Después de más de 10 años de gestiones, el distrito se creó por Ley N° 14140 y se instaló en 1962.",
    "highlights": [
      "Ley N° 14140",
      "4 de octubre de 1962",
      "Paulino Olivares Salvatierra"
    ],
    "paragraphs": [
      "El actual Distrito de María Parado de Bellido fue creado el <strong>05 de febrero de 1962</strong> en el Congreso de la República, mediante <strong>Ley N° 14140</strong> y promulgado el 18 de junio, durante el gobierno de Manuel Prado Ugarteche. Fue inaugurado e instalado el <strong>04 de octubre del mismo año</strong>.",
      "El primer Alcalde fue el señor <strong>Paulino Olivares Salvatierra</strong> y el gobernador <strong>Eustaquio Quicaño Tanta</strong>.",
      "Los pobladores lucharon más de 10 años para conseguir la distritalización, gracias a la habilidad de sus hijos. Participaron en la construcción de carreteras a Cusco (hasta Pampa gratis) y a Cangallo hasta Mollebamba, con una recompensa de solo 10 céntimos, dinero que también invirtieron para comprar la campana actual. Otra parte del esfuerzo lo hicieron los residentes en Lima.",
      "El Sr. Diputado <strong>Pedro C. Cárdenas Orosco</strong>, con influencia del Dr. Senador <strong>Arcaparu</strong>, presentó el proyecto de distritalización, logrando el objetivo deseado después de más de 10 años de gestiones."
    ]
  },
  {
    "era": "1980 – hoy",
    "title": "Organización Tradicional y Época Contemporánea",
    "summary": "La violencia de 1980-1995 provocó migración; desde el 2000 las familias retornan y reconstruyen el distrito.",
    "highlights": [
      "Minka y ayni",
      "Retorno 2000-2004",
      "Reconstrucción"
    ],
    "paragraphs": [
      "Pomabamba tenía una organización con usos y costumbres bajo la disciplina de sus autoridades y envarados. Existía la <strong>minka</strong> y el <strong>ayni</strong>, el respeto y el orden.",
      "Esta organización y convivencia se perdió a causa de los problemas políticos y sociales. Durante los años <strong>1980 al 1995</strong>, la intensa actividad terrorista en la zona provocó un fuerte movimiento migratorio hacia la capital y las ciudades de la costa, ocasionando el abandono de las tierras y actividades desarrolladas en el distrito como: la agricultura, crianza de animales, tejidos, etc.",
      "Durante los años 2000 a 2004, muchas familias retornaron y comenzaron a recuperar y reconstruir con gran esfuerzo las actividades de producción del distrito: la chacra, la crianza de animales, el tejido y las fiestas que hoy siguen dando vida a Pomabamba."
    ]
  }
];

const keyFacts = [
  { value: "+10,000", label: "años de historia" },
  { value: "1822", label: "sacrificio de la heroína" },
  { value: "1962", label: "creación del distrito" },
  { value: "3,268", label: "habitantes (censo 2025)" },
  { value: "3", label: "pisos ecológicos" },
];

const sections = [
  { href: "#heroina", label: "La heroína" },
  { href: "#resena", label: "Línea de tiempo" },
  { href: "#comunidades", label: "Comunidades" },
  { href: "#cultura", label: "Cultura" },
];

const DISTRICT_HAS = 9266.62;
const communities = [
  { name: "Pomabamba", type: "Capital distrital", has: 2822.19, altitude: "3,170", groupLabel: "Anexos", places: ["Ccachccara", "San Miguel de Acco", "San Martín de Ccoriacc", "Huascarpampa", "Ccasanccay", "Tucre"] },
  { name: "Santa Cruz de Ñuñunhuaycco", type: "Centro poblado", has: 4380.81, altitude: "3,500", groupLabel: "Barrios", places: ["Mayocancha", "Capillapata", "Haciendapata", "Calvario", "Callpana"] },
  { name: "Huayllabamba", type: "Comunidad", has: 1100, altitude: "3,175", groupLabel: "Barrio", places: ["Roccray"] },
  { name: "Urihuana", type: "Comunidad", has: 963.62, altitude: "3,170", groupLabel: "Barrios", places: ["Llullucha Pizara", "Carapuma", "Tancarpampa"] },
].map((c) => ({ ...c, share: (c.has / DISTRICT_HAS) * 100 }));

const culture = [
  {
    title: "Ayni y minka",
    kicker: "Trabajo comunal",
    text: "El <strong>ayni</strong> (reciprocidad) y la <strong>minka</strong> (trabajo colectivo) siguen vivos en las faenas y en las <strong>fiestas patronales y costumbristas</strong>. La comunidad participa voluntariamente y los <strong>cargontes</strong> retribuyen con comida, chicha de jora y música.",
    image: "/images/experiencias/faena-limpieza-canal-turismo-vivencial-pomabamba-ayacucho.webp",
    alt: "Comuneros de Pomabamba, Ayacucho, en una faena de limpieza de canal, ejemplo vivo del ayni y la minka",
    link: { href: "/experiencias/turismo-vivencial", label: "Vive una faena comunal" },
  },
  {
    title: "Música y danza",
    kicker: "Folklore",
    text: "Nuestras danzas y músicas acompañan el calendario agrícola y las fiestas religiosas: del carnaval a la siembra, cada celebración tiene su ritmo.",
    tags: ["Chinlili", "Chimaycha", "Qacchwa", "Toril", "Rejoneras", "Wacqrapukus"],
    image: "/images/comparsa-carnaval-pomabamba-ayacucho.webp",
    alt: "Comparsa de carnaval con ponchos y polleras recorriendo las calles de Pomabamba, Ayacucho",
    link: { href: "/festividades", label: "Ver el calendario de fiestas" },
