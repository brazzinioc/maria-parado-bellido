---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { fetchFestivities } from "../../lib/api";

const festivities = await fetchFestivities();

// Sort by date
const sortedFestivities = [...festivities].sort(
  (a, b) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime()
);

// SEO Keywords para festividades
const festivitiesKeywords = [
  "festividades Ayacucho",
  "fiestas patronales Perú",
  "cargontes tradición andina",
  "celebraciones María Parado de Bellido",
  "fiestas costumbristas Cangallo",
  "danzas tradicionales Ayacucho",
  "calendario festivo Pomabamba",
  "procesiones andinas",
  "fiesta patronal Perú",
  "tradiciones peruanas",
];

// Breadcrumbs
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Festividades", url: "/festividades" },
];

// Generar Event schema para cada festividad
const eventSchemas = sortedFestivities.map((festivity) => ({
  type: "event" as const,
  data: festivity,
}));

// ItemList schema para la lista de festividades
const festivitiesStructuredData = [
  {
    type: "itemList" as const,
    data: {
      name: "Festividades de María Parado de Bellido",
      description: "Calendario completo de festividades y celebraciones tradicionales en el distrito María Parado de Bellido, Ayacucho.",
      items: sortedFestivities.map((f) => ({
        name: f.name,
        description: f.description,
        url: `/festividades/${f.slug}`,
        image: f.images?.[0],
      })),
    },
  },
  ...eventSchemas,
];

const dateParts = (date: string) => {
  const d = new Date(date);
  return {
    day: d.toLocaleDateString("es-PE", { day: "2-digit", timeZone: "UTC" }),
    month: d.toLocaleDateString("es-PE", { month: "short", timeZone: "UTC" }).replace(".", ""),
    year: d.getUTCFullYear(),
  };
};

const formatRange = (start: string, end: string) => {
  const opts: Intl.DateTimeFormatOptions = { day: "numeric", month: "long", timeZone: "UTC" };
  const s = new Date(start).toLocaleDateString("es-PE", opts);
  if (start === end) return s;
  return `${s} al ${new Date(end).toLocaleDateString("es-PE", opts)}`;
};
---

<BaseLayout
  title="Festividades y fiestas patronales en María Parado de Bellido, Ayacucho"
  description="Calendario de festividades y fiestas costumbristas en María Parado de Bellido, Ayacucho. Descubre nuestras celebraciones patronales, cargontes y tradiciones andinas."
  image="/images/hero-festivities.webp"
  keywords={festivitiesKeywords}
  breadcrumbs={breadcrumbs}
  structuredData={festivitiesStructuredData}
>
  <PageHero
    eyebrow="Calendario festivo"
    title="Vive nuestras fiestas"
    intro="La fe y la tradición se encuentran en nuestras fiestas: procesiones, danzas, música y comida compartida."
    image="/images/hero-festivities.webp"
    imageAlt="Festividades tradicionales del distrito"
    breadcrumbs={breadcrumbs}
  />

  <section class="py-20 md:py-28">
    <div class="container-custom">
      <div class="max-w-3xl mb-14">
        <span class="eyebrow">Fe y tradición</span>
        <h2 class="section-heading">Calendario de fiestas</h2>
        <p class="text-lg leading-relaxed mb-4">
          Las festividades de María Parado de Bellido son expresiones vivas de nuestra fe católica entrelazada
          con creencias ancestrales andinas. Cada celebración es organizada por los cargontes, familias que con
          devoción y sacrificio asumen la responsabilidad de honrar a nuestros santos patronos.
        </p>
        <p class="text-lg leading-relaxed">
          Procesiones, danzas tradicionales, misas solemnes y comida comunitaria se unen en una explosión de
          color, música y espiritualidad que convoca a toda la comunidad.
        </p>
      </div>

      {sortedFestivities.length > 0 ? (
        <div class="space-y-6">
          {sortedFestivities.map((festivity) => {
            const d = dateParts(festivity.start_date);
            return (
              <a
                href={`/festividades/${festivity.slug}`}
                class="group grid grid-cols-1 md:grid-cols-12 overflow-hidden rounded-2xl bg-white border border-line hover:shadow-[0_18px_40px_-20px_rgba(43,33,28,0.35)] transition-shadow"
              >
                <div class="relative md:col-span-5 aspect-[16/10] md:aspect-auto md:min-h-[260px] overflow-hidden">
                  <img
                    src={festivity.images?.[0] || "/images/default-photo.webp"}
                    alt={festivity.name}
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                </div>
                <div class="md:col-span-7 flex gap-6 p-6 md:p-10">
                  <div class="flex-shrink-0 text-center">
                    <p class="font-heading text-4xl md:text-5xl font-semibold text-primary leading-none">{d.day}</p>
                    <p class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-ink">{d.month}</p>
                    <p class="text-xs text-ink-soft">{d.year}</p>
                  </div>
                  <div class="min-w-0">
                    <h3 class="font-heading text-2xl md:text-3xl font-semibold group-hover:text-primary transition-colors">
                      {festivity.name}
                    </h3>
                    <p class="mt-1 text-sm font-semibold text-secondary">{formatRange(festivity.start_date, festivity.end_date)}</p>
                    <p class="mt-4 leading-relaxed line-clamp-3">{festivity.description}</p>
                    {festivity.place?.name && (
                      <p class="mt-4 flex items-center gap-1.5 text-sm">
                        <svg class="h-4 w-4 text-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z" /></svg>
                        {festivity.place.name}
                      </p>
                    )}
                    <span class="link-arrow mt-5">Ver programa completo →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="rounded-2xl bg-white border border-line p-10 text-center">
          <p class="mb-6">No hay festividades programadas en este momento. Vuelve pronto o escríbenos para más información.</p>
          <a href="/planifica-tu-visita" class="btn-primary">Planifica tu visita</a>
        </div>
      )}
    </div>
  </section>

  <!-- Cargontes -->
  <section class="py-20 md:py-28 bg-secondary text-white">
    <div class="container-custom grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="relative aspect-[4/3] overflow-hidden rounded-2xl">
        <img src="/images/hero_3.webp" alt="Tradiciones y cultura viva en Pomabamba" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
      </div>
      <div class="max-w-xl">
        <span class="eyebrow !text-accent">Tradición</span>
        <h2 class="section-heading !text-white">El sistema de cargontes</h2>
        <p class="text-lg leading-relaxed text-white/85 mb-5">
          Los cargontes son el corazón de nuestras festividades. Familias enteras asumen el cargo de organizar
          las celebraciones: financian la banda de música, preparan la comida para cientos de personas, adornan
          la iglesia y coordinan las procesiones. Es un acto de fe, generosidad y servicio comunitario que
          fortalece nuestros lazos sociales y espirituales.
        </p>
        <p class="text-lg leading-relaxed text-white/85">
          Ser cargonte es un honor que se transmite con orgullo y que deja una huella imborrable en la memoria
          colectiva del distrito.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28">
    <div class="container-custom">
      <SectionHeading
        eyebrow="Sigue explorando"
        title="Descubre más de nuestro distrito"
        intro="Las festividades son solo una parte de nuestra cultura. Explora nuestros paisajes y conoce la historia de nuestro pueblo."
      />
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/lugares" class="btn-primary">Explorar destinos</a>
        <a href="/historia" class="btn-secondary">Conocer nuestra historia</a>
      </div>
    </div>
  </section>
</BaseLayout>
