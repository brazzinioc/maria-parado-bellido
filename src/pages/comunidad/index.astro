---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CommunityEventCard from "../../components/CommunityEventCard.astro";
import type { CommunityEvent } from "../../types";
import { fetchEvents } from "../../lib/api";

// Fallback usado solo si el CMS no devuelve eventos publicados
const fallbackEvents: CommunityEvent[] = [
  {
    id: "1",
    title: "Faena Comunal - Limpieza de Canales de Riego",
    slug: "faena-limpieza-canales",
    type: "faena",
    description: "Trabajo comunitario para la limpieza y mantenimiento de los canales de riego que abastecen a las chacras de Pomabamba. Participación obligatoria de todos los comuneros empadronados.",
    date: "2026-02-15",
    time: "6:00 AM",
    location: {
      name: "Canal Principal - Sector Allcaqapata",
      coordinates: { lat: -13.6014, lng: -74.2342 }
    },
    organizer: "Junta Directiva Comunal",
    isRecurring: true,
    recurrencePattern: "monthly"
  },
  {
    id: "2",
    title: "Pollada Pro-Fondos Escuela Inicial",
    slug: "pollada-escuela-inicial",
    type: "pollada",
    description: "Gran pollada bailable para recaudar fondos destinados a la mejora de infraestructura de la Escuela Inicial N° 432. Incluye música en vivo con orquesta típica.",
    date: "2026-02-22",
    time: "12:00 PM",
    location: {
      name: "Plaza Principal de Pomabamba",
      coordinates: { lat: -13.6014, lng: -74.2342 }
    },
    organizer: "APAFA - Escuela Inicial N° 432",
    isRecurring: false
  },
  {
    id: "3",
    title: "Asamblea General Ordinaria - Comunidad de Pomabamba",
    slug: "asamblea-general-febrero",
    type: "asamblea",
    description: "Asamblea mensual para tratar temas de interés comunal: distribución de agua, mantenimiento de caminos, preparativos para la fiesta patronal y elección de nuevos cargontes.",
    date: "2026-02-28",
    time: "10:00 AM",
    location: {
      name: "Salón Comunal de Pomabamba",
      coordinates: { lat: -13.6014, lng: -74.2342 }
    },
    organizer: "Presidente Comunal",
    isRecurring: true,
    recurrencePattern: "monthly"
  },
  {
    id: "4",
    title: "Minka - Techado de Casa Comunal",
    slug: "minka-techado-casa",
    type: "minka",
    description: "Trabajo colectivo tradicional (Minka) para el techado de la nueva casa comunal. Se solicita apoyo con materiales: ichu, palos, sogas. Se ofrecerá almuerzo y chicha de jora a los participantes.",
    date: "2026-03-08",
    time: "7:00 AM",
    location: {
      name: "Nueva Casa Comunal - Pomabamba",
      coordinates: { lat: -13.6014, lng: -74.2342 }
    },
    organizer: "Comité de Obra",
    isRecurring: false
  },
  {
    id: "5",
    title: "Reunión de Regantes - Sector Urihuana",
    slug: "reunion-regantes-urihuana",
    type: "reunion",
    description: "Reunión de coordinación para establecer el rol de riego de la temporada. Todos los usuarios del canal deben asistir con sus documentos de empadronamiento actualizados.",
    date: "2026-03-10",
    time: "3:00 PM",
    location: {
      name: "Local Comunal Urihuana",
      coordinates: { lat: -13.6100, lng: -74.2400 }
    },
    organizer: "Comité de Regantes",
    isRecurring: true,
    recurrencePattern: "monthly"
  },
  {
    id: "6",
    title: "Aniversario del Distrito - 195 Años",
    slug: "aniversario-distrito-195",
    type: "aniversario",
    description: "Celebración del 195° Aniversario de creación política del distrito María Parado de Bellido. Programa incluye: izamiento de bandera, desfile cívico-escolar, presentación de danzas típicas (Chinlili, Chimaycha) y verbena popular.",
    date: "2026-04-14",
    time: "8:00 AM",
    location: {
      name: "Plaza Principal de Pomabamba",
      coordinates: { lat: -13.6014, lng: -74.2342 }
    },
    organizer: "Municipalidad Distrital",
    isRecurring: true,
    recurrencePattern: "annual"
  },
  {
    id: "7",
    title: "Faena - Mantenimiento Camino a Allcaqapata",
    slug: "faena-camino-allcaqapata",
    type: "faena",
    description: "Trabajo comunal para reparar el camino de herradura que conecta Pomabamba con el mirador de Allcaqapata. Traer herramientas: pico, lampa, barreta.",
    date: "2026-03-15",
    time: "6:30 AM",
    location: {
      name: "Tramo Pomabamba - Allcaqapata",
      coordinates: { lat: -13.5950, lng: -74.2300 }
    },
    organizer: "Junta Directiva Comunal",
    isRecurring: false
  },
  {
    id: "8",
    title: "Pollada Deportiva - Club Juventud Pomabamba",
    slug: "pollada-club-juventud",
    type: "pollada",
    description: "Actividad pro-fondos para la compra de uniformes y equipamiento del club de fútbol Juventud Pomabamba. Incluye campeonato relámpago de fulbito.",
    date: "2026-03-22",
    time: "11:00 AM",
    location: {
      name: "Campo Deportivo de Pomabamba",
      coordinates: { lat: -13.6020, lng: -74.2350 }
    },
    organizer: "Club Deportivo Juventud Pomabamba",
    isRecurring: false
  }
];

// Contenido desde el CMS; si no hay eventos publicados, usa el fallback
const dbEvents = await fetchEvents();
const communityEvents = dbEvents.length ? dbEvents : fallbackEvents;

// Ordenar eventos por fecha
const sortedEvents = [...communityEvents].sort((a, b) =>
  new Date(a.date).getTime() - new Date(b.date).getTime()
);

// Filtrar eventos futuros y pasados
const today = new Date();
const upcomingEvents = sortedEvents.filter(e => new Date(e.date) >= today);
const pastEvents = sortedEvents.filter(e => new Date(e.date) < today);

const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Comunidad", url: "/comunidad" },
];

const activityTypes = [
  { title: "Faena comunal", text: "Trabajo obligatorio para todos los comuneros empadronados. Incluye limpieza de canales, mantenimiento de caminos y obras de beneficio común." },
  { title: "Minka y ayni", text: "Trabajo colectivo voluntario que pervive principalmente en las fiestas patronales. Los cargontes retribuyen a los participantes con comida, chicha de jora y música." },
  { title: "Asamblea", text: "Reunión general donde se toman decisiones importantes para la comunidad. Participación con voz y voto de todos los comuneros." },
  { title: "Reunión", text: "Encuentros de coordinación entre sectores, comités o grupos específicos para organizar actividades o resolver temas puntuales." },
  { title: "Pollada / actividad", text: "Eventos sociales para recaudar fondos. Incluyen venta de comida, música en vivo y espacios de confraternidad comunal." },
  { title: "Aniversario", text: "Celebraciones especiales del distrito, comunidades, instituciones o fechas históricas importantes para nuestra identidad." },
];

const communities = [
  { name: "Pomabamba", detail: "Capital del distrito · 3,236 msnm" },
  { name: "Urihuana", detail: "Comunidad campesina · Zona Quechua" },
  { name: "Ñuñunhuaycco", detail: "Comunidad campesina · Zona Quechua" },
  { name: "Huayllabamba", detail: "Comunidad campesina · Zona Quechua" },
];
---

<BaseLayout
  title="Vida comunal en María Parado de Bellido: faenas, minkas y eventos"
  description="Calendario de actividades comunales, faenas, asambleas y eventos en el distrito María Parado de Bellido, Cangallo, Ayacucho."
  image="/images/hero_5.webp"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Comunidad"
    title="Vida comunal"
    intro="Faenas, asambleas, minkas y actividades que fortalecen nuestra identidad."
    image="/images/hero_5.webp"
    imageAlt="Vida comunitaria en los Andes de Ayacucho"
    breadcrumbs={breadcrumbs}
  />

  <section class="py-20 md:py-24">
    <div class="container-custom grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <span class="eyebrow">Ayni y minka</span>
        <h2 class="section-heading">Tradiciones que perviven en nuestras fiestas</h2>
      </div>
      <div class="lg:col-span-7 space-y-5 text-lg leading-relaxed">
        <p>
          El <strong class="text-ink">ayni</strong> (reciprocidad) y la <strong class="text-ink">minka</strong> (trabajo colectivo),
          tradiciones heredadas de nuestros antepasados, cobran vida especialmente durante las
          <strong class="text-ink">fiestas patronales y costumbristas</strong>. En estas celebraciones, la comunidad
          participa voluntariamente y los <strong class="text-ink">cargontes</strong> retribuyen con comida, chicha de jora y música.
        </p>
        <p>
          Aquí encontrarás el calendario de actividades comunales donde puedes participar o conocer
          más sobre nuestra forma de vida comunitaria.
        </p>
      </div>
    </div>
  </section>

  {upcomingEvents.length > 0 && (
    <section class="py-20 md:py-24 bg-white">
      <div class="container-custom">
        <SectionHeading eyebrow="Calendario" title="Próximos eventos" align="left" />
        <div class="grid gap-6">
          {upcomingEvents.map((event) => (
            <CommunityEventCard event={event} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-20 md:py-24">
    <div class="container-custom">
      <SectionHeading eyebrow="Organización" title="Tipos de actividades comunales" align="left" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {activityTypes.map((item) => (
          <article class="rounded-2xl bg-white border border-line p-6 md:p-8">
            <h3 class="font-heading text-2xl font-semibold mb-3">{item.title}</h3>
            <p class="leading-relaxed">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-white">
    <div class="container-custom">
      <SectionHeading eyebrow="Territorio" title="Nuestras comunidades" align="left">
        <a slot="actions" href="/historia#comunidades" class="btn-secondary">Conoce más</a>
      </SectionHeading>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {communities.map((c) => (
          <li class="rounded-2xl bg-secondary-soft p-6">
            <h3 class="font-heading text-2xl font-semibold text-secondary-dark">{c.name}</h3>
            <p class="mt-2 text-sm">{c.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative py-24 md:py-32 overflow-hidden">
    <img src="/images/hero_1.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-ink/70" aria-hidden="true"></div>
    <div class="container-custom relative text-center">
      <h2 class="section-heading !text-white">¿Te gustaría participar en una minka?</h2>
      <p class="text-lg md:text-xl text-white/85 mb-10 max-w-2xl mx-auto">
        Visita nuestro distrito y vive la experiencia del trabajo comunitario andino. Es una oportunidad única
        de conectar con nuestra cultura ancestral y contribuir al bienestar de la comunidad.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/experiencias/turismo-vivencial" class="btn-primary">Turismo vivencial</a>
        <a href="/festividades" class="btn-ghost-light">Conocer festividades</a>
      </div>
    </div>
  </section>
</BaseLayout>
