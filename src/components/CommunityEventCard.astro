---
/**
 * CommunityEventCard - Actividad de la agenda del distrito (CMS).
 * Sin foto, muestra una ilustración según el tipo de actividad.
 */
import type { CommunityEvent } from "../types";
import { eventCoverImage } from "../lib/placeholders";

interface Props {
  event: CommunityEvent;
}

const { event } = Astro.props;

const MONTHS = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "setiembre", "octubre", "noviembre", "diciembre"];
const WEEKDAYS = ["domingos", "lunes", "martes", "miércoles", "jueves", "viernes", "sábados"];
const [y, m, d] = event.date.split("T")[0].split("-").map(Number);
const date = new Date(Date.UTC(y, m - 1, d));

// Las actividades que se repiten muestran su frecuencia en vez de una fecha que pronto queda vieja.
const when =
  event.isRecurring && event.recurrencePattern === "weekly"
    ? `Todos los ${WEEKDAYS[date.getUTCDay()]}`
    : event.isRecurring && event.recurrencePattern === "monthly"
      ? `Cada mes, el día ${d}`
      : event.isRecurring && event.recurrencePattern === "annual"
        ? `Cada ${d} de ${MONTHS[m - 1]}`
        : `${d} de ${MONTHS[m - 1]} de ${y}`;

const typeLabels: Record<CommunityEvent["type"], string> = {
  faena: "Faena comunal",
  pollada: "Actividad pro fondos",
  reunion: "Reunión",
  asamblea: "Asamblea",
  minka: "Minka",
  aniversario: "Aniversario",
  otro: /feria/i.test(event.title) ? "Feria" : "Actividad",
};
---

<article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-white">
  <div class="relative aspect-[16/9] overflow-hidden bg-sand-200">
    <img
      src={eventCoverImage(event)}
      alt={`${event.title} en ${event.location.name || "Pomabamba"}, María Parado de Bellido, Ayacucho`}
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-ink shadow-sm">
      {typeLabels[event.type]}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-5 md:p-6">
    <p class="text-sm font-semibold text-primary">{when}{event.time && ` · ${event.time}`}</p>
    <h3 class="mt-1 font-heading text-2xl font-semibold leading-snug text-ink">{event.title}</h3>
    <p class="mt-3 leading-relaxed">{event.description}</p>
    <ul class="mt-auto space-y-1.5 pt-5 text-sm">
      {event.location.name && (
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 flex-shrink-0 text-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z" /></svg>
          {event.location.name}
        </li>
      )}
      {event.organizer && (
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          {event.organizer}
        </li>
      )}
    </ul>
  </div>
</article>
