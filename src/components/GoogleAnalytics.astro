---
/**
 * Google Analytics 4 (gtag.js).
 *
 * - Solo se carga en el sitio de producción (VERCEL_ENV=production): las vistas
 *   previas de cada PR y los builds locales no ensucian las estadísticas.
 *   Fuera de Vercel se puede forzar con PUBLIC_GA_ENABLED=true.
 * - El sitio navega con ClientRouter (sin recargar la página), así que la vista
 *   de página se envía a mano en cada "astro:page-load", con el título y la URL
 *   correctos. En GA hay que desactivar «Cambios de página basados en eventos
 *   del historial del navegador» (Flujo de datos → Medición mejorada → Vistas de
 *   página → Configuración avanzada) para no contarlas dos veces.
 * - Eventos propios: contact_whatsapp (clic en un enlace de WhatsApp) y
 *   click_reservar (botones de reserva de las rutas).
 */
const { measurementId } = Astro.props;
const GA_MEASUREMENT_ID = measurementId || import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const enabled =
  !import.meta.env.DEV &&
  Boolean(GA_MEASUREMENT_ID) &&
  (process.env.VERCEL_ENV === "production" || import.meta.env.PUBLIC_GA_ENABLED === "true");
---

{enabled && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      // El <head> se conserva entre navegaciones: esto corre una sola vez por visita.
      if (!window.__gaReady) {
        window.__gaReady = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        gtag("js", new Date());
        gtag("config", GA_MEASUREMENT_ID, { send_page_view: false });

        document.addEventListener("astro:page-load", function () {
          gtag("event", "page_view", {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname,
          });
        });

        document.addEventListener("click", function (e) {
          var link = e.target instanceof Element ? e.target.closest("a[href]") : null;
          if (!link) return;
          var href = link.getAttribute("href") || "";
          if (/wa\.me|api\.whatsapp\.com/.test(href)) {
            var label = (link.textContent || "").trim().replace(/\s+/g, " ").slice(0, 80);
            gtag("event", /reservar/i.test(label) ? "click_reservar" : "contact_whatsapp", {
              link_text: label,
              page_path: location.pathname,
            });
          }
        });
      }
    </script>
  </>
)}
