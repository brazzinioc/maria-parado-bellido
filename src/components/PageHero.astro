---
/**
 * PageHero - Encabezado fotográfico para páginas internas.
 * Incluye breadcrumbs visibles (el schema BreadcrumbList lo genera BaseLayout).
 * Entrada animada: la foto se acerca despacio y los textos aparecen escalonados.
 * Con transitionName, la foto continúa la de la tarjeta del listado (transición de vista).
 */
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  image: string;
  imageAlt?: string;
  imagePosition?: string;
  breadcrumbs?: Crumb[];
  size?: "md" | "lg";
  transitionName?: string;
}

const {
  title,
  eyebrow,
  intro,
  image,
  imageAlt = "",
  imagePosition = "center",
  breadcrumbs = [],
  size = "md",
  transitionName,
} = Astro.props;

const imgAttrs = {
  src: image,
  alt: imageAlt,
  loading: "eager" as const,
  fetchpriority: "high" as const,
  class: "page-hero-img absolute inset-0 h-full w-full object-cover",
  style: `object-position: ${imagePosition}`,
};
---

<header
  class:list={[
    "relative flex items-end overflow-hidden bg-ink",
    size === "lg" ? "min-h-[70vh]" : "min-h-[52vh]",
  ]}
>
  {transitionName ? <img {...imgAttrs} transition:name={transitionName} /> : <img {...imgAttrs} />}
  <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/40 to-ink/10" aria-hidden="true"></div>

  <div class="container-custom relative w-full pb-10 md:pb-14 pt-24">
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="page-hero-in mb-6" style="--i: 0">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-white/75">
          {breadcrumbs.map((crumb, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i < breadcrumbs.length - 1 ? (
                <a href={crumb.url} class="hover:text-white transition-colors">{crumb.name}</a>
              ) : (
                <span class="text-white" aria-current="page">{crumb.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="max-w-3xl">
      {eyebrow && <p class="page-hero-in text-xs md:text-sm font-semibold uppercase tracking-[0.25em] text-accent mb-3" style="--i: 1">{eyebrow}</p>}
      <h1 class="page-hero-in font-heading font-semibold !text-white text-4xl md:text-6xl leading-[1.05]" style="--i: 1">{title}</h1>
      {intro && <p class="page-hero-in mt-4 text-lg md:text-xl text-white/85 max-w-2xl" style="--i: 2">{intro}</p>}
      {Astro.slots.has("actions") && (
        <div class="page-hero-in mt-8 flex flex-wrap gap-3" style="--i: 3">
          <slot name="actions" />
        </div>
      )}
    </div>
  </div>
</header>

<style>
  /* Solo transform y opacidad: no mueve el resto de la página ni retrasa la carga de la foto. */
  .page-hero-img { animation: page-hero-zoom 1.8s var(--ease-out-expo) both; }
  .page-hero-in { animation: page-hero-in 0.7s var(--ease-out-expo) both; animation-delay: calc(var(--i, 0) * 90ms + 60ms); }
  @keyframes page-hero-zoom { from { transform: scale(1.06); } }
  @keyframes page-hero-in { from { opacity: 0; transform: translateY(14px); } }
</style>
