---
/**
 * CensoCifras - Población del distrito según el último censo del INEI. Se usa en /datos.
 * Pensado para leerse sin saber estadística: hallazgos en frases, "Pomabamba en 100
 * personas", comparación directa con el Perú y un "¿Qué significa?" junto a cada término.
 * Orden: ¿Quiénes somos? → ¿Qué hablamos? → ¿Cómo vivimos? → ¿Qué aprendemos? → aula.
 * Cifras: el CSV de /public/datos (tools/censo-inei.mjs). Textos: src/data/censo-<año>.json.
 * Ambos se combinan en src/lib/censo.ts.
 */
import { censo } from "../lib/censo";

const fmt = (n: number) => n.toLocaleString("en-US");
const pct = (n: number) => `${n.toFixed(1)}%`;

const { total, hombres, mujeres } = censo.poblacion;
const { evolucion } = censo;
const { anterior } = evolucion;
const gruposEvolucion = [...new Set(evolucion.indicadores.map((i) => i.grupo))];
const puntos = (n: number) => `${n > 0 ? "+" : n < 0 ? "−" : ""}${Math.abs(n).toFixed(1)}`;

// 100 personas: se pinta en el servidor el primer indicador; el script cambia los demás.
const [cienInicial] = censo.cien;

// Pirámide: de mayor a menor edad. La escala deja aire para la cifra junto a cada barra.
const piramide = [...censo.piramide].reverse();
const ESCALA = 180;
const destacados: Record<string, string> = {
  "0-4": "La base se estrecha",
  "20-24": "Menos jóvenes",
};

const [identidad, servicios, educacion] = censo.comparativo;
const bloques = [
  { id: "lengua", grupo: identidad, intro: "Lengua e identidad" },
  { id: "vivienda", grupo: servicios, intro: "Servicios en la vivienda" },
  { id: "educacion", grupo: educacion, intro: "Educación e internet" },
];
---

<section id="poblacion" class="scroll-mt-40 py-20 md:py-28">
  <div class="container-custom">
    <!-- ¿Quiénes somos? -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
      <div class="lg:col-span-7">
        <span class="eyebrow">Población · Censos Nacionales {censo.anio}</span>
        <h2 class="section-heading">¿Quiénes somos?</h2>
        <p class="text-lg leading-relaxed">
          Lo que dice el censo más reciente del INEI sobre quiénes somos, cómo vivimos y qué nos falta,
          contado de forma sencilla. Datos para conocer el distrito de María Parado de Bellido y para trabajar en el aula.
        </p>
      </div>
      <div class="lg:col-span-5 rounded-2xl bg-white border border-line p-6 md:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-ink-soft">Somos</p>
        <p class="mt-1 font-heading text-6xl md:text-7xl font-semibold leading-none text-ink" data-contar>{fmt(total)}</p>
        <p class="mt-3 text-ink-soft">
          habitantes: {fmt(mujeres)} mujeres y {fmt(hombres)} hombres.
          <a href="#cambios" class="underline hover:text-ink">¿Cuántos éramos en {anterior.anio}?</a>
        </p>
      </div>
    </div>

    <dl class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-px overflow-hidden rounded-2xl border border-line bg-line">
      {censo.resumen.map((r) => (
        <div class="bg-white px-5 py-4">
          <dd class="font-heading text-2xl font-semibold text-ink" data-contar>{r.valor}</dd>
          <dt class="mt-0.5 text-sm">{r.etiqueta}</dt>
          {r.def && (
            <details class="censo-def mt-1.5">
              <summary>¿Qué significa?</summary>
              <p>{r.def}</p>
            </details>
          )}
        </div>
      ))}
    </dl>

    <!-- Lo que dice el censo -->
    <div class="mt-16">
      <h3 class="font-heading text-3xl font-semibold text-ink">Lo que dice el censo, en cinco frases</h3>
      <ol class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {censo.hallazgos.map((h) => (
          <li class="flex flex-col rounded-2xl bg-white border border-line p-5">
            <span class="font-heading text-4xl font-semibold leading-none text-primary">{h.cifra}</span>
            <span class="mt-2 font-semibold leading-snug text-ink">{h.texto}</span>
            <span class="mt-auto pt-3 text-sm leading-relaxed">{h.contexto}</span>
          </li>
        ))}
      </ol>
    </div>

    <!-- Pomabamba en 100 personas -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center rounded-3xl bg-white border border-line p-6 md:p-10" data-cien>
      <div class="lg:col-span-5">
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-primary">Imagina que somos 100</p>
        <h3 class="mt-2 font-heading text-3xl font-semibold text-ink leading-tight">Pomabamba en 100 personas</h3>
        <p class="mt-3">Si el distrito fuera un grupo de 100 personas, ¿cuántas…? Elige un dato:</p>
        <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Elige un dato">
          {censo.cien.map((c, i) => (
            <button
              type="button"
              class="censo-chip"
              aria-pressed={i === 0 ? "true" : "false"}
              data-valor={c.valor}
              data-peru={c.peru}
              data-texto={c.texto}
              data-base={c.base}
            >{c.chip}</button>
          ))}
        </div>
        <p class="mt-8" aria-live="polite">
          <span class="block font-heading text-6xl font-semibold leading-none text-primary" data-cien-valor>{cienInicial.valor}</span>
          <span class="mt-2 block text-lg font-semibold text-ink">de cada 100 <span data-cien-texto>{cienInicial.texto}</span></span>
          <span class="mt-2 block text-ink-soft">En el Perú: <strong class="text-ink" data-cien-peru>{cienInicial.peru}</strong> de cada 100.</span>
          <span class="mt-1 block text-sm text-ink-soft" data-cien-base>{cienInicial.base}</span>
        </p>
      </div>
      <div class="lg:col-span-7">
        <div class="censo-cien" aria-hidden="true" data-graf>
          {Array.from({ length: 100 }, (_, i) => (
            <svg viewBox="0 0 20 28" class:list={["censo-persona", i < cienInicial.valor && "is-on"]} style={`--n: ${i}`}>
              <circle cx="10" cy="6" r="5" />
              <path d="M2 27v-8a8 8 0 0 1 16 0v8z" />
            </svg>
          ))}
        </div>
        <ul class="mt-4 flex justify-center flex-wrap gap-x-6 gap-y-2 text-sm text-ink" aria-label="Leyenda">
          <li class="flex items-center gap-2"><span class="censo-swatch bg-primary" aria-hidden="true"></span>Sí</li>
          <li class="flex items-center gap-2"><span class="censo-swatch censo-swatch-off" aria-hidden="true"></span>No</li>
        </ul>
      </div>
    </div>

    <!-- ¿Qué edad tenemos? -->
    <div class="mt-16">
      <h3 class="font-heading text-3xl font-semibold text-ink">¿Qué edad tenemos?</h3>
      <p class="mt-2 max-w-3xl">De cada 100 personas, cuántas son niños, jóvenes y adultos, o adultos mayores.</p>
      <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink" aria-label="Leyenda">
        {censo.edades.grupos.map((g) => (
          <li class="flex items-center gap-2"><span class={`censo-swatch censo-edad-${g.id}`} aria-hidden="true"></span>{g.etiqueta} <span class="text-ink-soft">({g.rango})</span></li>
        ))}
      </ul>
      <!-- data-graf va en el contenedor: la barra empieza recortada (clip-path) y el navegador
           la daría por invisible, así que nunca se activaría si se observara a sí misma. -->
      <div class="censo-edades mt-5 space-y-4" data-graf>
        {censo.edades.ambitos.map((a) => (
          <div class="grid grid-cols-1 sm:grid-cols-[7rem_1fr] items-center gap-x-4 gap-y-1.5">
            <span class:list={["text-sm font-semibold", a.nombre === "Perú" ? "text-ink-soft" : "text-ink"]}>{a.nombre}</span>
            <div
              class="censo-apilada"
              data-no-reveal
              role="img"
              aria-label={`${a.nombre}: ${censo.edades.grupos.map((g, i) => `${g.etiqueta.toLowerCase()} ${a.valores[i]}%`).join(", ")}`}
            >
              {censo.edades.grupos.map((g, i) => (
                <span class={`censo-edad-${g.id}`} style={`width:${a.valores[i]}%`}>{Math.round(a.valores[i])}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm text-ink-soft">Hay menos niños y más adultos mayores que en el promedio del país.</p>
    </div>

    <!-- Pirámide + envejecimiento -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <figure class="lg:col-span-7 rounded-2xl bg-white border border-line p-5 md:p-8">
        <figcaption>
          <h4 class="font-heading text-2xl font-semibold text-ink">En detalle: la pirámide de población</h4>
          <p class="mt-1 text-sm">
            Cuántas personas hay en cada grupo de 5 años de edad. A la izquierda los hombres, a la derecha las mujeres;
            los más pequeños abajo y los mayores arriba.
          </p>
        </figcaption>

        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink" aria-label="Leyenda">
          <li class="flex items-center gap-2"><span class="censo-swatch censo-h" aria-hidden="true"></span>Hombres <span class="text-ink-soft">{fmt(hombres)}</span></li>
          <li class="flex items-center gap-2"><span class="censo-swatch censo-m" aria-hidden="true"></span>Mujeres <span class="text-ink-soft">{fmt(mujeres)}</span></li>
        </ul>

        <div class="censo-piramide mt-5" data-graf role="img" aria-label={`Pirámide de población del distrito por edad y sexo, Censo ${censo.anio}. ${fmt(hombres)} hombres y ${fmt(mujeres)} mujeres.`}>
          {piramide.map((r, fila) => (
            <div class:list={["censo-fila", destacados[r.edad] && "is-destacada"]} style={`--f: ${piramide.length - 1 - fila}`}>
              <div class="censo-lado censo-lado-h">
                <span class="censo-barra censo-h" style={`width:${(r.hombres / ESCALA) * 100}%`}><span class="censo-valor">{r.hombres}</span></span>
              </div>
              <span class="censo-edad">{r.edad}</span>
              <div class="censo-lado">
                <span class="censo-barra censo-m" style={`width:${(r.mujeres / ESCALA) * 100}%`}><span class="censo-valor">{r.mujeres}</span></span>
              </div>
            </div>
          ))}
          <p class="censo-pie" aria-hidden="true">años de edad</p>
        </div>

        <ul class="mt-6 space-y-2 text-sm">
          {Object.entries(destacados).map(([edad, titulo]) => {
            const fila = censo.piramide.find((r) => r.edad === edad)!;
            const ref = censo.piramide.find((r) => r.edad === "15-19")!;
            return (
              <li class="flex gap-3">
                <span class="mt-1.5 h-2 w-2 flex-shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                <span>
                  <strong class="text-ink">{titulo} ({edad} años):</strong>{" "}
                  {fmt(fila.hombres + fila.mujeres)} personas, frente a {fmt(ref.hombres + ref.mujeres)} de 15 a 19 años.
                </span>
              </li>
            );
          })}
        </ul>
      </figure>

      <div class="lg:col-span-5">
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-primary">Lo que muestra la pirámide</p>
        <h4 class="mt-2 font-heading text-3xl font-semibold text-ink leading-tight">Un pueblo que envejece</h4>
        <p class="mt-4 text-lg leading-relaxed">
          Nacen menos niñas y niños, y muchos jóvenes salen a estudiar o trabajar fuera. Los que se quedan son,
          cada vez más, nuestros mayores: guardianes de la lengua, las fiestas y el trabajo comunal.
        </p>
        <dl class="mt-8 space-y-6">
          {censo.envejecimiento.map((e) => (
            <div class="border-t border-line pt-5">
              <dt class="text-sm">{e.indicador}</dt>
              <dd class="mt-1 flex items-baseline gap-3">
                <span class="font-heading text-4xl font-semibold text-ink" data-contar>{e.distrito}{e.unidad}</span>
                <span class="text-sm text-ink-soft">Perú: {e.peru}{e.unidad}</span>
              </dd>
              {e.def && (
                <dd>
                  <details class="censo-def mt-1.5">
                    <summary>¿Qué significa?</summary>
                    <p>{e.def}</p>
                  </details>
                </dd>
              )}
            </div>
          ))}
        </dl>
      </div>
    </div>

    <!-- ¿Qué hablamos? ¿Cómo vivimos? ¿Qué aprendemos? -->
    <div class="mt-20">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink" aria-label="Leyenda de las comparaciones">
        <li class="flex items-center gap-2"><span class="censo-swatch bg-primary" aria-hidden="true"></span>Pomabamba (distrito)</li>
        <li class="flex items-center gap-2"><span class="censo-swatch censo-swatch-peru" aria-hidden="true"></span>Promedio del Perú</li>
      </ul>

      <div class="mt-6 space-y-14">
        {bloques.map(({ id, grupo, intro }) => (
          <div id={id} class="scroll-mt-40 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-14">
            <div class="lg:col-span-4">
              <p class="text-sm font-semibold uppercase tracking-[0.15em] text-ink-soft">{intro}</p>
              <h3 class="mt-2 font-heading text-3xl font-semibold text-ink">{grupo.pregunta}</h3>
              <p class="mt-2 font-heading text-xl text-primary-dark">{grupo.titular}</p>
              <p class="mt-2 leading-relaxed">{grupo.texto}</p>
            </div>
            <ul class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-4">
              {grupo.filas.map((f) => {
                const mas = f.distrito >= f.peru;
                return (
                  <li class="flex flex-col rounded-2xl bg-white border border-line p-5">
                    <div class="flex items-start justify-between gap-3">
                      <span class="font-semibold leading-snug text-ink">{f.indicador}</span>
                      <span class:list={["censo-badge", mas ? "is-mas" : "is-menos"]}>
                        <span aria-hidden="true">{mas ? "▲" : "▼"}</span> {mas ? "más" : "menos"} que el Perú
                      </span>
                    </div>
                    <div class="mt-4 space-y-2" data-graf role="img" aria-label={`${f.indicador}: Pomabamba ${pct(f.distrito)}, Perú ${pct(f.peru)}`}>
                      <div class="censo-par">
                        <span class="censo-par-nombre">Pomabamba</span>
                        <span class="censo-par-pista"><span class="censo-par-barra bg-primary" style={`width:${f.distrito}%`}></span></span>
                        <span class="censo-par-valor text-ink">{pct(f.distrito)}</span>
                      </div>
                      <div class="censo-par">
                        <span class="censo-par-nombre">Perú</span>
                        <span class="censo-par-pista"><span class="censo-par-barra censo-swatch-peru" style={`width:${f.peru}%`}></span></span>
                        <span class="censo-par-valor text-ink-soft">{pct(f.peru)}</span>
                      </div>
                    </div>
                    {f.def && (
                      <details class="censo-def mt-3">
                        <summary>¿Qué significa?</summary>
                        <p>{f.def}</p>
                      </details>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>

      <details class="mt-10 rounded-2xl border border-line bg-white">
        <summary class="cursor-pointer px-6 py-4 text-sm font-semibold text-ink">Ver la tabla completa (con la provincia de Cangallo y el departamento de Ayacucho)</summary>
        <div class="overflow-x-auto px-6 pb-6">
          <table class="w-full min-w-[560px] text-sm">
            <thead>
              <tr class="border-b border-line text-left text-ink">
                <th class="py-2 pr-4 font-semibold">Indicador</th>
                <th class="py-2 px-2 text-right font-semibold">Distrito</th>
                <th class="py-2 px-2 text-right font-semibold">Cangallo</th>
                <th class="py-2 px-2 text-right font-semibold">Ayacucho</th>
                <th class="py-2 pl-2 text-right font-semibold">Perú</th>
              </tr>
            </thead>
            <tbody>
              {censo.comparativo.flatMap((g) => g.filas).map((f) => (
                <tr class="border-b border-line last:border-0">
                  <td class="py-2 pr-4">{f.indicador}</td>
                  <td class="py-2 px-2 text-right font-semibold text-ink">{pct(f.distrito)}</td>
                  <td class="py-2 px-2 text-right">{pct(f.cangallo)}</td>
                  <td class="py-2 px-2 text-right">{pct(f.ayacucho)}</td>
                  <td class="py-2 pl-2 text-right">{pct(f.peru)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </div>

    <!-- ¿Cómo hemos cambiado? -->
    <div id="cambios" class="scroll-mt-40 mt-20">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-primary">Del censo {anterior.anio} al {censo.anio}</p>
      <h3 class="mt-2 font-heading text-3xl font-semibold text-ink">¿Cómo hemos cambiado?</h3>

      <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14">
        <div class="lg:col-span-5">
          <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line">
            <div class="bg-white px-5 py-4">
              <dt class="text-sm">Censo {anterior.anio}</dt>
              <dd class="mt-1 font-heading text-4xl font-semibold text-ink-soft" data-contar>{fmt(anterior.total)}</dd>
              <dd class="text-sm">personas censadas</dd>
            </div>
            <div class="bg-white px-5 py-4">
              <dt class="text-sm">Censo {censo.anio}</dt>
              <dd class="mt-1 font-heading text-4xl font-semibold text-ink" data-contar>{fmt(total)}</dd>
              <dd class="text-sm">personas censadas</dd>
            </div>
          </dl>
          <div class="mt-5 rounded-2xl bg-accent-soft p-5 md:p-6">
            <h4 class="font-heading text-xl font-semibold text-ink">¿Por qué tanta diferencia?</h4>
            <p class="mt-2 leading-relaxed">
              Los dos censos no contaron igual. En {anterior.anio} el censo se hizo en un solo día y registró a cada persona
              <strong class="text-ink">donde estaba ese día</strong> (censo {anterior.metodo}). En {censo.anio} se registró a cada persona
              <strong class="text-ink">donde vive habitualmente</strong>, aunque estuviera de viaje (censo {evolucion.metodoActual}).
            </p>
            <p class="mt-2 leading-relaxed">
              Quienes en {anterior.anio} estaban trabajando o estudiando fuera no se contaron en el distrito. Por eso no podemos saber
              cuánto creció de verdad la población. Los porcentajes se comparan mejor, porque no dependen de cuántas personas se contaron.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink" aria-label="Leyenda">
            <li class="flex items-center gap-2"><span class="censo-antes static" aria-hidden="true"></span>Censo {anterior.anio}</li>
            <li class="flex items-center gap-2"><span class="censo-ahora static" aria-hidden="true"></span>Censo {censo.anio}</li>
          </ul>
          <details class="censo-def mt-3">
            <summary>¿Qué son los «puntos»?</summary>
            <p>Puntos porcentuales: la diferencia entre dos porcentajes. Si el desagüe pasa de 17.7% a 26.7% de las viviendas, son 9 puntos más.</p>
          </details>
          {gruposEvolucion.map((grupo) => (
            <div class="mt-6">
              <p class="text-xs font-semibold uppercase tracking-[0.15em] text-ink-soft">{grupo}</p>
              <ul class="mt-3 space-y-4">
                {evolucion.indicadores.filter((i) => i.grupo === grupo).map((i) => {
                  const dif = i.ahora - i.antes;
                  return (
                    <li>
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="text-sm font-semibold text-ink">{i.etiqueta}</span>
                        <span class="flex-shrink-0 text-sm tabular-nums text-ink">
                          <span class="text-ink-soft">{pct(i.antes)}</span> → <strong>{pct(i.ahora)}</strong>
                        </span>
                      </div>
                      <div class:list={["censo-cambio mt-2", dif < 0 && "is-baja"]} data-graf role="img" aria-label={`${i.etiqueta}: ${pct(i.antes)} en ${anterior.anio} y ${pct(i.ahora)} en ${censo.anio}, ${puntos(dif)} puntos.`}>
                        <span class="censo-cambio-tramo" style={`left:${Math.min(i.antes, i.ahora)}%;width:${Math.abs(dif)}%`}></span>
                        <span class="censo-antes" style={`left:${i.antes}%`}></span>
                        <span class="censo-ahora" style={`left:${i.ahora}%;--desde:${i.antes}%`}></span>
                      </div>
                      <p class="mt-1 text-xs text-ink-soft">{puntos(dif)} puntos</p>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
          <p class="mt-6 text-sm text-ink-soft">
            Porcentaje de la población, las viviendas habitadas o los hogares del distrito, en una escala de 0 a 100%.
            <a href={anterior.csv} download class="underline hover:text-ink">Descargar el censo {anterior.anio} del distrito (CSV)</a>.
          </p>
        </div>
      </div>
    </div>

    <!-- Para el aula -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-12 gap-8 rounded-3xl bg-secondary-soft p-6 md:p-10">
      <div class="lg:col-span-4">
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-secondary">Para docentes y estudiantes</p>
        <h3 class="mt-2 font-heading text-3xl font-semibold text-secondary-dark leading-tight">Preguntas para el aula</h3>
        <p class="mt-3">
          Descarga los {censo.indicadores} indicadores del censo para el distrito, comparados con Cangallo, Ayacucho y el Perú. Abre en Excel, Google Sheets o LibreOffice.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={censo.csv} download class="btn-accent">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14" /></svg>
            Descargar datos (CSV)
          </a>
        </div>
      </div>
      <ol class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-4">
        {censo.preguntas.map((q, i) => (
          <li class="flex gap-4 rounded-2xl bg-white p-5">
            <span class="font-heading text-2xl font-semibold text-secondary leading-none" aria-hidden="true">{i + 1}</span>
            <span class="text-ink leading-relaxed">{q}</span>
          </li>
        ))}
      </ol>
    </div>

    <p class="mt-6 text-sm text-ink-soft">
      Fuente: <a href={censo.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-ink">{censo.fuente}</a>.
      Ubigeo {censo.ubigeo}. Censo {anterior.anio}: <a href={anterior.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-ink">{anterior.fuente}</a>.
      "De cada 100" redondea los porcentajes del censo.
    </p>
  </div>
</section>

<script>
  // Gráficos que se dibujan al llegar a ellos ([data-graf]) y cifras que cuentan hasta su
  // valor ([data-contar]). Solo con las animaciones activas (html.anim, ver BaseLayout):
  // sin ellas, gráficos y cifras se muestran completos desde el inicio.
  function contar(el: HTMLElement) {
    const final = el.textContent ?? "";
    const m = final.match(/^([\d,]+)(\.\d+)?/);
    if (!m) return;
    const decimales = m[2] ? m[2].length - 1 : 0;
    const objetivo = Number((m[1] + (m[2] ?? "")).replace(/,/g, ""));
    const resto = final.slice(m[0].length);
    // Ancho fijo mientras cuenta: la cifra no empuja lo que tiene al lado.
    const ancho = el.getBoundingClientRect().width;
    if (getComputedStyle(el).display === "inline") el.style.display = "inline-block";
    el.style.minWidth = `${ancho}px`;
    el.style.fontVariantNumeric = "tabular-nums";
    const inicio = performance.now();
    const DURACION = 1100;
    const paso = (t: number) => {
      const avance = Math.min(1, (t - inicio) / DURACION);
      const v = objetivo * (1 - Math.pow(1 - avance, 3));
      el.textContent = avance < 1 ? v.toLocaleString("en-US", { minimumFractionDigits: decimales, maximumFractionDigits: decimales }) + resto : final;
      if (avance < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  }

  document.addEventListener("astro:page-load", () => {
    // Misma condición que BaseLayout usa para html.anim (sin depender del orden de los scripts).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          if (el.hasAttribute("data-contar")) contar(el);
          else el.classList.add("is-visible");
          observer.unobserve(el);
        });
      },
      { threshold: 0.35 }
    );
    document.querySelectorAll("[data-graf], [data-contar]").forEach((el) => observer.observe(el));
  });

  // "Pomabamba en 100 personas": cambia el dato al elegir otro botón.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-cien]").forEach((root) => {
      const personas = root.querySelectorAll(".censo-persona");
      const set = (sel: string, text: string) => {
        const el = root.querySelector(sel);
        if (el) el.textContent = text;
      };
      root.querySelectorAll<HTMLButtonElement>(".censo-chip").forEach((btn) => {
        btn.addEventListener("click", () => {
          const d = btn.dataset;
          const valor = Number(d.valor);
          root.querySelectorAll(".censo-chip").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          personas.forEach((p, i) => p.classList.toggle("is-on", i < valor));
          set("[data-cien-valor]", String(valor));
          set("[data-cien-texto]", d.texto ?? "");
          set("[data-cien-peru]", d.peru ?? "");
          set("[data-cien-base]", d.base ?? "");
        });
      });
    });
  });
</script>

<style>
  .censo-h { background: #2a6fc0; }
  .censo-m { background: var(--color-primary); }
  .censo-swatch { display: inline-block; width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0; }
  .censo-swatch-off { background: var(--color-line); }
  .censo-swatch-peru { background: #8a7d75; }

  /* "¿Qué significa?": desplegable nativo, sin JavaScript. */
  .censo-def summary {
    display: inline-flex; align-items: center; gap: 0.35rem;
    cursor: pointer; list-style: none;
    font-size: 0.8125rem; font-weight: 600; color: var(--color-primary-dark);
  }
  .censo-def summary::-webkit-details-marker { display: none; }
  .censo-def summary::before {
    content: "i"; display: inline-grid; place-items: center;
    width: 1.05rem; height: 1.05rem; border-radius: 9999px;
    border: 1.5px solid currentColor; font-size: 0.7rem; font-style: italic; font-family: Georgia, serif;
  }
  .censo-def summary:hover { text-decoration: underline; }
  .censo-def p {
    margin-top: 0.5rem; padding: 0.625rem 0.75rem; border-radius: 0.5rem;
    background: var(--color-accent-soft); font-size: 0.875rem; line-height: 1.5; color: var(--color-ink);
  }

  /* 100 personas */
  .censo-chip {
    padding: 0.45rem 0.9rem; border-radius: 9999px; border: 1px solid var(--color-line);
    background: #fff; font-size: 0.875rem; font-weight: 600; color: var(--color-ink);
    transition: background-color 120ms, border-color 120ms, color 120ms;
  }
  .censo-chip:hover { border-color: var(--color-primary); }
  .censo-chip[aria-pressed="true"] { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .censo-cien { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 6px 4px; max-width: 26rem; margin-inline: auto; }
  .censo-persona { width: 100%; height: auto; fill: var(--color-line); transition: fill 200ms; }
  :global(html.anim) .censo-persona { transition-delay: calc(var(--n) * 9ms); }
  .censo-persona.is-on { fill: var(--color-primary); }
  @media (prefers-reduced-motion: reduce) { .censo-persona { transition: none; } }

  /* Grupos de edad: barra apilada al 100% con la cifra dentro. */
  .censo-edad-ninos { background: var(--color-accent); }
  .censo-edad-adultos { background: var(--color-secondary); }
  .censo-edad-mayores { background: #6b4a7a; }
  .censo-apilada { display: flex; height: 2.5rem; border-radius: 0.5rem; overflow: hidden; gap: 2px; background: #fff; }
  .censo-apilada > span {
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 0.95rem; font-variant-numeric: tabular-nums; color: #fff;
  }
  .censo-apilada > .censo-edad-ninos { color: var(--color-ink); }

  /* Pirámide: dos lados que crecen desde el centro, con la cifra siempre visible. */
  .censo-piramide { display: flex; flex-direction: column; gap: 2px; }
  .censo-fila {
    display: grid;
    grid-template-columns: 1fr 3.25rem 1fr;
    align-items: center;
    height: 17px;
    border-radius: 4px;
  }
  .censo-fila.is-destacada { background: var(--color-accent-soft); }
  .censo-lado { display: flex; align-items: center; height: 100%; }
  .censo-lado-h { justify-content: flex-end; }
  .censo-barra { position: relative; display: block; flex-shrink: 0; height: 12px; min-width: 2px; }
  .censo-lado-h .censo-barra { border-radius: 4px 0 0 4px; }
  .censo-lado:not(.censo-lado-h) .censo-barra { border-radius: 0 4px 4px 0; }
  .censo-edad { text-align: center; font-size: 11px; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; }
  .censo-valor {
    position: absolute; top: 50%; transform: translateY(-50%);
    font-size: 11px; line-height: 1; color: var(--color-ink); font-variant-numeric: tabular-nums;
  }
  .censo-lado-h .censo-valor { right: calc(100% + 4px); }
  .censo-lado:not(.censo-lado-h) .censo-valor { left: calc(100% + 4px); }
  .censo-pie { margin-top: 6px; text-align: center; font-size: 11px; color: var(--color-ink-soft); }

  /* Comparaciones: Pomabamba y Perú, dos barras sobre la misma escala de 0 a 100%. */
  .censo-par { display: grid; grid-template-columns: 5.5rem 1fr 3.25rem; align-items: center; gap: 0.5rem; }
  .censo-par-nombre { font-size: 0.8125rem; color: var(--color-ink-soft); }
  .censo-par-pista { display: block; height: 14px; border-radius: 4px; background: var(--color-sand-200); overflow: hidden; }
  .censo-par-barra { display: block; height: 100%; border-radius: 4px; }
  .censo-par-valor { text-align: right; font-size: 0.875rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  /* Cambio entre censos: punto hueco (antes) y lleno (ahora) sobre una pista de 0 a 100%. */
  .censo-cambio { position: relative; height: 16px; background: linear-gradient(var(--color-line), var(--color-line)) center / 100% 2px no-repeat; }
  .censo-cambio-tramo { position: absolute; top: 50%; height: 4px; transform: translateY(-50%); background: var(--color-primary-soft); border-radius: 2px; }
  .censo-antes, .censo-ahora { position: absolute; top: 50%; transform: translate(-50%, -50%); width: 14px; height: 14px; border-radius: 9999px; }
  .censo-antes { background: #fff; border: 2.5px solid #8a7d75; }
  .censo-ahora { background: var(--color-primary); box-shadow: 0 0 0 2px #fff; }
  .censo-antes.static, .censo-ahora.static { position: static; transform: none; display: inline-block; flex-shrink: 0; }
  .censo-badge {
    flex-shrink: 0; white-space: nowrap; border-radius: 9999px; padding: 0.15rem 0.55rem;
    font-size: 0.75rem; font-weight: 600; color: var(--color-ink);
  }
  .censo-badge.is-mas { background: var(--color-primary-soft); }
  .censo-badge.is-menos { background: var(--color-sand-200); }
</style>

<style>
  /* Animación de los gráficos al llegar a ellos. Estado inicial solo con html.anim y mientras
     el gráfico no tenga .is-visible; la transición lleva al estado final, que es el normal. */
  :global(html.anim) [data-graf]:not(.is-visible) .censo-persona.is-on { fill: var(--color-line); }

  /* Barra apilada de edades: se descubre de izquierda a derecha. */
  .censo-apilada { clip-path: inset(0 0 0 0 round 0.5rem); transition: clip-path 1s var(--ease-out-expo); }
  :global(html.anim) .censo-edades:not(.is-visible) .censo-apilada { clip-path: inset(0 100% 0 0 round 0.5rem); }
  .censo-edades > * + * .censo-apilada { transition-delay: 150ms; }

  /* Pirámide: cada barra crece desde el centro, de abajo hacia arriba; la cifra aparece con ella. */
  .censo-barra { transition: clip-path 0.8s var(--ease-out-expo); transition-delay: calc(var(--f, 0) * 35ms); }
  .censo-lado-h .censo-barra { clip-path: inset(-2px 0 -2px -3rem); }
  .censo-lado:not(.censo-lado-h) .censo-barra { clip-path: inset(-2px -3rem -2px 0); }
  :global(html.anim) .censo-piramide:not(.is-visible) .censo-lado-h .censo-barra { clip-path: inset(-2px 0 -2px 100%); }
  :global(html.anim) .censo-piramide:not(.is-visible) .censo-lado:not(.censo-lado-h) .censo-barra { clip-path: inset(-2px 100% -2px 0); }

  /* Comparación con el Perú: las dos barras crecen, Pomabamba primero. */
  .censo-par-barra { transform-origin: left center; transition: transform 0.9s var(--ease-out-expo); }
  .censo-par + .censo-par .censo-par-barra { transition-delay: 120ms; }
  :global(html.anim) [data-graf]:not(.is-visible) .censo-par-barra { transform: scaleX(0); }

  /* Del censo anterior al actual: el punto lleno viaja desde el valor de antes. */
  .censo-ahora { transition: left 1s var(--ease-out-expo) 150ms; }
  .censo-cambio-tramo { transition: clip-path 1s var(--ease-out-expo) 150ms; clip-path: inset(0); }
  :global(html.anim) .censo-cambio:not(.is-visible) .censo-ahora { left: var(--desde) !important; }
  :global(html.anim) .censo-cambio:not(.is-visible) .censo-cambio-tramo { clip-path: inset(0 100% 0 0); }
  :global(html.anim) .censo-cambio.is-baja:not(.is-visible) .censo-cambio-tramo { clip-path: inset(0 0 0 100%); }
</style>
