---
/**
 * PriceNote - Aviso de que los precios mostrados son referenciales.
 * Se usa junto a cualquier precio del sitio (rutas, entradas a lugares).
 */
interface Props {
  /** Texto propio; por defecto, el aviso general. */
  text?: string;
  class?: string;
}

const {
  text = "Precios referenciales por persona, en soles. Pueden variar según la temporada, el tamaño del grupo, la disponibilidad de guías y otras condiciones. Confirma el precio final por WhatsApp antes de reservar.",
  class: className,
} = Astro.props;
---

<p class:list={["flex gap-2.5 text-sm leading-relaxed text-ink-soft", className]} role="note">
  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path stroke-linecap="round" d="M12 11v5M12 8h.01" />
  </svg>
  <span>{text}</span>
</p>
