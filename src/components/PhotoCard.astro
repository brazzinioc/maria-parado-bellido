---
/**
 * PhotoCard - Tarjeta donde la fotografía es la protagonista.
 * El texto va sobre la imagen, con un degradado inferior para legibilidad.
 */
interface Props {
  href: string;
  image: string;
  alt: string;
  title: string;
  subtitle?: string;
  meta?: string;
  badge?: string;
  cta?: string;
  size?: "tall" | "wide" | "square" | "fill";
  headingLevel?: "h2" | "h3";
  class?: string;
}

const {
  href,
  image,
  alt,
  title,
  subtitle,
  meta,
  badge,
  cta = "Explorar",
  size = "tall",
  headingLevel: Heading = "h3",
  class: className = "",
} = Astro.props;

const sizeClasses = {
  tall: "aspect-[4/5]",
  wide: "aspect-[16/10]",
  square: "aspect-square",
  fill: "h-full min-h-[18rem]",
};
---

<a
  href={href}
  class:list={[
    "group relative block overflow-hidden rounded-2xl bg-ink focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/40",
    sizeClasses[size],
    className,
  ]}
>
  <img
    src={image}
    alt={alt}
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-transparent" aria-hidden="true"></div>

  {badge && (
    <span class="absolute top-4 left-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-ink">
      {badge}
    </span>
  )}

  <div class="absolute inset-x-0 bottom-0 p-5 md:p-6 text-white">
    {meta && (
      <p class="mb-2 flex items-center gap-1.5 text-xs font-medium text-white/80">
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z" />
        </svg>
        {meta}
      </p>
    )}
    <Heading class="font-heading text-2xl md:text-[1.7rem] font-semibold leading-tight !text-white">
      {title}
    </Heading>
    {subtitle && <p class="mt-1.5 text-sm text-white/85 line-clamp-2">{subtitle}</p>}
    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-white">
      {cta}
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </span>
  </div>
</a>
